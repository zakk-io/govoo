# Python
*.pyc
__pycache__/
*.pyo
*.egg-info/
dist/
build/
*.egg
*.whl

# Docker
.env

# MCP configs (contain secrets/tokens)
opencode.json
.mcp.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Playwright logs
.playwright-mcp/

# Temporary
/tmp/
*.log

# Node
node_modules/

# Git
.git/

# Vendor Odoo installation (not part of this repo's source; only the
# custom govoo_* addons are tracked)
/odoo-19.0/*
!/odoo-19.0/addons/
/odoo-19.0/addons/*
!/odoo-19.0/addons/govoo_*/
# CLAGOV brand theme + its Enterprise Home Menu dependency: not govoo_*-
# named, but genuinely part of this repo's own source (built/vendored in
# for this project), not an unrelated vendor addon -- tracked so a fresh
# checkout has the branding, not just the Govoo business modules.
!/odoo-19.0/addons/clagov_brand_theme/
!/odoo-19.0/addons/clagov_brand_theme_website/
!/odoo-19.0/addons/zxs_entp_theme/
# The actual image build definition -- this repo's own, not vendor
# Odoo's. Was never tracked, so a Python dependency added locally (e.g.
# govoo_ai's PyMuPDF/fitz) never reached any other environment's image
# build; confirmed live (2026-10-26) this is why a fresh/separate
# server's container never had it installed despite the module
# declaring it, breaking module upgrades that cascade into govoo_ai.
!/odoo-19.0/Dockerfile
!/odoo-19.0/requirements.txt
# vendor's own .gitignore re-includes these three via its own negation rules
/odoo-19.0/.github/
/odoo-19.0/.gitignore
/odoo-19.0/.weblate.json

# Agent/tool scratch files
/.kilo/
/session-ses_*.md
