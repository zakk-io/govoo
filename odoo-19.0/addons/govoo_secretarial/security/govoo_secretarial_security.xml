<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Multi-company record rules for all register models -->
    <record id="govoo_register_director_comp_rule" model="ir.rule">
        <field name="name">Register Director: multi-company</field>
        <field name="model_id" ref="model_govoo_register_director"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
    </record>

    <record id="govoo_register_director_portal_rule" model="ir.rule">
        <field name="name">Register Director: Director Portal own record</field>
        <field name="model_id" ref="model_govoo_register_director"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_director_portal'))]"/>
    </record>

    <record id="govoo_register_member_comp_rule" model="ir.rule">
        <field name="name">Register Member: multi-company</field>
        <field name="model_id" ref="model_govoo_register_member"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
    </record>

    <record id="govoo_register_member_portal_rule" model="ir.rule">
        <field name="name">Register Member: Shareholder Portal own record</field>
        <field name="model_id" ref="model_govoo_register_member"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_shareholder_portal'))]"/>
    </record>

    <record id="govoo_register_beneficial_owner_comp_rule" model="ir.rule">
        <field name="name">Register Beneficial Owner: multi-company</field>
        <field name="model_id" ref="model_govoo_register_beneficial_owner"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_secretary'))]"/>
    </record>

    <record id="govoo_register_charge_comp_rule" model="ir.rule">
        <field name="name">Register Charge: multi-company</field>
        <field name="model_id" ref="model_govoo_register_charge"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
    </record>

    <record id="govoo_register_entry_comp_rule" model="ir.rule">
        <field name="name">Register Entry: multi-company</field>
        <field name="model_id" ref="model_govoo_register_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
    </record>

</odoo>
