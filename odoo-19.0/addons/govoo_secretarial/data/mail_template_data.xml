<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Issue #236: these only fire once the corresponding
             ir.config_parameter deadline is explicitly set by an admin,
             see govoo_secretarial_cron.py for the [CONFIRM] discipline. -->

        <record id="mail_template_charge_registration_reminder" model="mail.template">
            <field name="name">Register of Charges: Registration Reminder</field>
            <field name="model_id" ref="model_govoo_register_charge"/>
            <field name="subject">Charge registration deadline approaching</field>
            <field name="description">Sent to Company Secretaries when a charge nears its registration deadline (issue #236)</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>
        Hello,<br/><br/>
        A charge against <strong t-out="object.chargee_partner_id.name or ''">chargee</strong>
        (created <t t-out="object.date_created or ''">date</t>) still needs to be
        registered, and its registration deadline is approaching.
    </p>
    <div style="text-align: center; padding: 16px 0px 16px 0px;">
        <a t-attf-href="/odoo/govoo.register.charge/{{ object.id }}"
           style="padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px">
            View Charge</a>
    </div>
</div>
            </field>
        </record>

        <record id="mail_template_beneficial_owner_declaration_reminder" model="mail.template">
            <field name="name">Register of Beneficial Owners: Declaration Reminder</field>
            <field name="model_id" ref="model_govoo_register_beneficial_owner"/>
            <field name="subject">Beneficial ownership declaration deadline approaching</field>
            <field name="description">Sent to Company Secretaries when a beneficial owner's declaration nears its deadline (issue #236)</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>
        Hello,<br/><br/>
        <strong t-out="object.partner_id.name or ''">Beneficial owner</strong> became
        registrable on <t t-out="object.date_became_registrable or ''">date</t> and
        still needs to be declared/filed, and the declaration deadline is approaching.
    </p>
    <div style="text-align: center; padding: 16px 0px 16px 0px;">
        <a t-attf-href="/odoo/govoo.register.beneficial.owner/{{ object.id }}"
           style="padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px">
            View Register Entry</a>
    </div>
</div>
            </field>
        </record>

    </data>
</odoo>
