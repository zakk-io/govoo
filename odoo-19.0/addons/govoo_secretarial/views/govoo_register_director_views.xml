<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_register_director_view_list" model="ir.ui.view">
        <field name="name">govoo.register.director.list</field>
        <field name="model">govoo.register.director</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="role"/>
                <field name="date_appointed" width="130px"/>
                <field name="date_resigned" width="130px"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_register_director_view_form" model="ir.ui.view">
        <field name="name">govoo.register.director.form</field>
        <field name="model">govoo.register.director</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="role"
                                   help="Distinguishes statutory officer roles, which carry different legal duties and liability."/>
                            <field name="state"
                                   help="Reflects this person's current legal capacity to act as a director of the company."/>
                        </group>
                        <group>
                            <field name="date_appointed"
                                   help="Triggers the statutory filing deadline for notifying the registrar of this appointment."/>
                            <field name="date_resigned"
                                   help="Triggers the statutory filing deadline for notifying the registrar of this resignation."/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Appointment Reference">
                        <field name="appointment_id"
                               help="The instrument of appointment — the primary legal evidence for this register entry."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="govoo_register_director_action" model="ir.actions.act_window">
        <field name="name">Register of Directors</field>
        <field name="res_model">govoo.register.director</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
