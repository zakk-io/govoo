<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_register_entry_view_list" model="ir.ui.view">
        <field name="name">govoo.register.entry.list</field>
        <field name="model">govoo.register.entry</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="effective_date"/>
                <field name="register_model"/>
                <field name="res_id"/>
                <field name="change_type"/>
                <field name="user_id"/>
                <field name="notes"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_register_entry_view_form" model="ir.ui.view">
        <field name="name">govoo.register.entry.form</field>
        <field name="model">govoo.register.entry</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="register_model"/>
                            <field name="res_id"/>
                            <field name="change_type"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="govoo_register_entry_view_search" model="ir.ui.view">
        <field name="name">govoo.register.entry.search</field>
        <field name="model">govoo.register.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="register_model"/>
                <field name="user_id"/>
                <filter name="filter_date_range" string="Date Range"
                        date="effective_date"/>
                <group>
                    <filter name="group_register" string="Register"
                            context="{'group_by': 'register_model'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'effective_date'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="govoo_register_entry_action" model="ir.actions.act_window">
        <field name="name">Audit Ledger</field>
        <field name="res_model">govoo.register.entry</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
