<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_register_member_view_list" model="ir.ui.view">
        <field name="name">govoo.register.member.list</field>
        <field name="model">govoo.register.member</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="date_entered"/>
                <field name="date_ceased"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_register_member_view_form" model="ir.ui.view">
        <field name="name">govoo.register.member.form</field>
        <field name="model">govoo.register.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="date_entered"/>
                        </group>
                        <group>
                            <field name="date_ceased"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="govoo_register_member_action" model="ir.actions.act_window">
        <field name="name">Register of Members</field>
        <field name="res_model">govoo.register.member</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
