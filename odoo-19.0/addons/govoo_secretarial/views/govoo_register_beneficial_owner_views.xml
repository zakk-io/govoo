<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_register_beneficial_owner_view_list" model="ir.ui.view">
        <field name="name">govoo.register.beneficial.owner.list</field>
        <field name="model">govoo.register.beneficial.owner</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="nature_of_control"/>
                <field name="date_became_registrable"/>
                <field name="is_provisional" widget="badge"
                       decoration-danger="is_provisional == True"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_register_beneficial_owner_view_form" model="ir.ui.view">
        <field name="name">govoo.register.beneficial.owner.form</field>
        <field name="model">govoo.register.beneficial.owner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Provisional"
                            bg_color="bg-danger"
                            invisible="not is_provisional"/>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="nature_of_control"/>
                        </group>
                        <group>
                            <field name="date_became_registrable"/>
                            <field name="evidence_document_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="is_provisional" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="govoo_register_beneficial_owner_view_search" model="ir.ui.view">
        <field name="name">govoo.register.beneficial.owner.search</field>
        <field name="model">govoo.register.beneficial.owner</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="nature_of_control"/>
                <filter name="filter_provisional" string="Provisional"
                        domain="[('is_provisional', '=', True)]"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('is_provisional', '=', False)]"/>
                <group>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="govoo_register_beneficial_owner_action" model="ir.actions.act_window">
        <field name="name">Register of Beneficial Owners</field>
        <field name="res_model">govoo.register.beneficial.owner</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
