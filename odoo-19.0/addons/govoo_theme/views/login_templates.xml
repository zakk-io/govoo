<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Issue #250: a single scoping class, added via xpath rather than
         replacing web.login_layout's own markup, so the real Clagov login
         artwork (Open Item #1, not yet supplied) can be dropped in later
         by targeting this same class, with no further template changes. -->
    <template id="login_layout_clagov" inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('container')][1]" position="attributes">
            <attribute name="class" add="o_clagov_login" separator=" "/>
        </xpath>
    </template>

</odoo>
