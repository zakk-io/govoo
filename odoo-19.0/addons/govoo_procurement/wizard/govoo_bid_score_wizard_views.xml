<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_govoo_bid_score_wizard_form" model="ir.ui.view">
        <field name="name">govoo.bid.score.wizard.form</field>
        <field name="model">govoo.bid.score.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="bid_id"/>
                    <field name="govoo_technical_score"/>
                    <field name="govoo_financial_score"/>
                </group>
                <footer>
                    <button name="action_submit" string="Submit Score" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_govoo_bid_score_wizard" model="ir.actions.act_window">
        <field name="name">Submit Score</field>
        <field name="res_model">govoo.bid.score.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
