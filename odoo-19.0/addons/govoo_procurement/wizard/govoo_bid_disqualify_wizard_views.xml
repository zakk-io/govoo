<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_govoo_bid_disqualify_wizard_form" model="ir.ui.view">
        <field name="name">govoo.bid.disqualify.wizard.form</field>
        <field name="model">govoo.bid.disqualify.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="bid_id"/>
                    <field name="reason" placeholder="e.g. Submitted certificate of experience shows 4 years; tender requires 10."/>
                </group>
                <footer>
                    <button name="action_submit" string="Disqualify Bid" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_govoo_bid_disqualify_wizard" model="ir.actions.act_window">
        <field name="name">Disqualify Bid</field>
        <field name="res_model">govoo.bid.disqualify.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
