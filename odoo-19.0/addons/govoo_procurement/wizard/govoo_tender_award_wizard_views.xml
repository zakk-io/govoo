<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_govoo_tender_award_wizard_form" model="ir.ui.view">
        <field name="name">govoo.tender.award.wizard.form</field>
        <field name="model">govoo.tender.award.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="tender_id"/>
                    <field name="awarded_bid_id"/>
                </group>
                <footer>
                    <button name="action_submit" string="Confirm Award" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_govoo_tender_award_wizard" model="ir.actions.act_window">
        <field name="name">Confirm Award</field>
        <field name="res_model">govoo.tender.award.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
