<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Issue #294: deactivates (not deletes) the native "Purchase
         Agreements" menu, which duplicated govoo.tender's own tendering
         flow and sat unused. The underlying purchase.requisition
         model/feature is untouched, only its nav entry is hidden, so
         there is a single, unambiguous path to start a tender. -->
    <record id="purchase_requisition.menu_purchase_requisition_pro_mgt" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <!-- Vendor contact management now goes through the Contacts app
         (govoo_procurement.menu_govoo_vendor_companies, company-only)
         instead of this native res.partner shortcut nested under
         Purchase > Orders, which just duplicated it. -->
    <record id="purchase.menu_procurement_management_supplier_name" model="ir.ui.menu">
        <field name="active">False</field>
    </record>
</odoo>
