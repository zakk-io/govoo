<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Only one new model, govoo.tender, is introduced by this module
             (issue #205); purchase.order/res.partner just gain extra
             fields, whose access rights and company-scoped record rules
             are already native to Purchase. This group exists for role
             clarity ("Procurement Officer" in the user story) and grants
             the native Purchase access an internal governance user would
             otherwise lack.

             product.group_product_manager is also implied: a Procurement
             Officer needs to be able to add a product/service when raising
             an RFQ (a plain purchase.group_purchase_user has read-only
             access to the product catalog, confirmed against
             odoo/addons/product/security/ir.model.access.csv), otherwise
             they can never create a priced line for a vendor who isn't
             already in the catalog.

             Issue #296: stock.group_stock_user is implied so the Officer
             can validate the goods receipt that purchase_stock generates
             on PO confirmation; without it, confirming a PO would work
             but there'd be no way to ever complete the receipt step the
             3-way match depends on. -->
        <record id="group_govoo_procurement_officer" model="res.groups">
            <field name="name">Procurement Officer</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="govoo_base.res_groups_privilege_governance"/>
            <field name="implied_ids" eval="[
                (4, ref('govoo_base.group_govoo_user')),
                (4, ref('purchase.group_purchase_user')),
                (4, ref('product.group_product_manager')),
                (4, ref('stock.group_stock_user')),
            ]"/>
        </record>

        <record id="govoo_tender_company_rule" model="ir.rule">
            <field name="name">Tender: multi-company</field>
            <field name="model_id" ref="model_govoo_tender"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Issue #315/#316/#317: split the all-powerful Procurement
             Officer role into three separate responsibilities (run the
             process / judge the bids / approve the outcome), matching
             standard procurement segregation-of-duties practice. Each new
             role gets its own privilege (not sharing the Officer's
             res_groups_privilege_governance), so they render as
             independent checkboxes on the Users form rather than a
             mutually-exclusive selector, same construction already used
             for Contract Manager/Approver in govoo_base_groups.xml. -->
        <record model="res.groups.privilege" id="res_groups_privilege_procurement_evaluator">
            <field name="name">Procurement Evaluator</field>
            <field name="category_id" ref="base.module_category_extra"/>
        </record>

        <record id="group_govoo_procurement_evaluator" model="res.groups">
            <field name="name">Procurement Evaluator</field>
            <field name="privilege_id" ref="res_groups_privilege_procurement_evaluator"/>
            <field name="implied_ids" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
            <field name="comment">Reviews vendor bids and scores Technical/Financial criteria only. Cannot create tenders, edit bid items, or Award.</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_procurement_approver">
            <field name="name">Procurement Approver</field>
            <field name="category_id" ref="base.module_category_extra"/>
        </record>

        <record id="group_govoo_procurement_approver" model="res.groups">
            <field name="name">Procurement Approver</field>
            <field name="privilege_id" ref="res_groups_privilege_procurement_approver"/>
            <field name="implied_ids" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
            <field name="comment">Reviews completed scoring and Awards the tender. Cannot create tenders, edit bids, or enter scores.</field>
        </record>
    </data>
</odoo>
