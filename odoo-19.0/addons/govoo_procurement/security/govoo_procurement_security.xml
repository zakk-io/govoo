<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Only one new model, govoo.tender, is introduced by this module
             (issue #205); purchase.order/res.partner just gain extra
             fields, whose access rights and company-scoped record rules
             are already native to Purchase. This group exists for role
             clarity ("Procurement Officer" in the user story) and grants
             the native Purchase access an internal governance user would
             otherwise lack.

             product.group_product_manager is also implied: a Procurement
             Officer needs to be able to add a product/service when raising
             an RFQ (a plain purchase.group_purchase_user has read-only
             access to the product catalog, confirmed against
             odoo/addons/product/security/ir.model.access.csv), otherwise
             they can never create a priced line for a vendor who isn't
             already in the catalog.

             Issue #296: stock.group_stock_user is implied so the Officer
             can validate the goods receipt that purchase_stock generates
             on PO confirmation; without it, confirming a PO would work
             but there'd be no way to ever complete the receipt step the
             3-way match depends on. -->
        <record id="group_govoo_procurement_officer" model="res.groups">
            <field name="name">Procurement Officer</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="govoo_base.res_groups_privilege_governance"/>
            <field name="implied_ids" eval="[
                (4, ref('govoo_base.group_govoo_user')),
                (4, ref('purchase.group_purchase_user')),
                (4, ref('product.group_product_manager')),
                (4, ref('stock.group_stock_user')),
            ]"/>
        </record>

        <record id="govoo_tender_company_rule" model="ir.rule">
            <field name="name">Tender: multi-company</field>
            <field name="model_id" ref="model_govoo_tender"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Issue #315/#316/#317: split the all-powerful Procurement
             Officer role into three separate responsibilities (run the
             process / judge the bids / approve the outcome), matching
             standard procurement segregation-of-duties practice. Each new
             role gets its own privilege (not sharing the Officer's
             res_groups_privilege_governance), so they render as
             independent checkboxes on the Users form rather than a
             mutually-exclusive selector, same construction already used
             for Contract Manager/Approver in govoo_base_groups.xml. -->
        <record model="res.groups.privilege" id="res_groups_privilege_procurement_evaluator">
            <field name="name">Procurement Evaluator</field>
            <field name="category_id" ref="base.module_category_extra"/>
        </record>

        <record id="group_govoo_procurement_evaluator" model="res.groups">
            <field name="name">Procurement Evaluator</field>
            <field name="privilege_id" ref="res_groups_privilege_procurement_evaluator"/>
            <field name="implied_ids" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
            <field name="comment">Reviews vendor bids and scores Technical/Financial criteria only. Cannot create tenders, edit bid items, or Award.</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_procurement_approver">
            <field name="name">Procurement Approver</field>
            <field name="category_id" ref="base.module_category_extra"/>
        </record>

        <record id="group_govoo_procurement_approver" model="res.groups">
            <field name="name">Procurement Approver</field>
            <field name="privilege_id" ref="res_groups_privilege_procurement_approver"/>
            <field name="implied_ids" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
            <field name="comment">Reviews completed scoring and Awards the tender. Cannot create tenders, edit bids, or enter scores.</field>
        </record>

        <!-- Issue #333: external/extra Procurement Committee members (the
             Officer plus additional members, some outside the
             organization) need read-only visibility into just their
             assigned tender's evaluation, not a full internal role.
             Mirrors govoo_base.group_govoo_director_portal exactly
             (portal-only, no internal licence); the record rules below
             mirror govoo_board's own committee-scoped Director Portal
             rules (committee_id.member_ids.partner_id = user.partner_id.id),
             the same mechanism already proven there, reused rather than
             reinvented. Issue #337 split the tender's single evaluation
             meeting into separate Technical/Financial pairs, so a member
             is in scope if they're on *either* meeting's committee; an
             OR across both paths, not just the first one. -->
        <record id="group_govoo_procurement_committee_portal" model="res.groups">
            <field name="name">Procurement Committee Member (Portal)</field>
            <field name="sequence">41</field>
            <field name="privilege_id" ref="govoo_base.res_groups_privilege_governance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="comment">External/extra committee member self-service. Portal-only, no internal licence. Read-only visibility into the tenders their committee is evaluating.</field>
        </record>

        <record id="govoo_tender_committee_portal_rule" model="ir.rule">
            <field name="name">Tender: Procurement Committee Portal scope</field>
            <field name="model_id" ref="model_govoo_tender"/>
            <field name="domain_force">['|', ('technical_evaluation_meeting_id.committee_id.member_ids.partner_id', '=', user.partner_id.id), ('financial_evaluation_meeting_id.committee_id.member_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_govoo_procurement_committee_portal'))]"/>
        </record>

        <record id="purchase_order_committee_portal_rule" model="ir.rule">
            <field name="name">Purchase Order (Bid): Procurement Committee Portal scope</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">['|', ('govoo_tender_id.technical_evaluation_meeting_id.committee_id.member_ids.partner_id', '=', user.partner_id.id), ('govoo_tender_id.financial_evaluation_meeting_id.committee_id.member_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_govoo_procurement_committee_portal'))]"/>
        </record>

        <!-- Issue #329: once Technical and Financial Evaluation are
             done and the tender is Awarded, the full package (minutes,
             Technical Score, Financial Score) is handed to the Legal
             Officer to draft the contract. Narrow, read-only, internal
             role; own privilege (not shared with Officer's), same
             construction already used for Evaluator/Approver so it
             renders as an independent checkbox rather than a mutually-
             exclusive selector. Scoped to Awarded tenders only via the
             record rules below, not by field-level restriction; same
             breadth-vs-depth tradeoff the existing Auditor role already
             makes (full read on the tender/bid record, not a stripped
             field set), reusing that precedent rather than inventing a
             different one. -->
        <record model="res.groups.privilege" id="res_groups_privilege_legal_officer">
            <field name="name">Legal Officer</field>
            <field name="category_id" ref="base.module_category_extra"/>
        </record>

        <record id="group_govoo_legal_officer" model="res.groups">
            <field name="name">Legal Officer</field>
            <field name="privilege_id" ref="res_groups_privilege_legal_officer"/>
            <field name="implied_ids" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
            <field name="comment">Read-only access to an Awarded tender's evaluation minutes, Technical Score, and Financial Score, to draft the resulting contract. No write access anywhere, and no visibility into tenders still being evaluated.</field>
        </record>

        <record id="govoo_tender_legal_officer_rule" model="ir.rule">
            <field name="name">Tender: Legal Officer sees only Awarded tenders</field>
            <field name="model_id" ref="model_govoo_tender"/>
            <field name="domain_force">[('evaluation_stage', '=', 'awarded')]</field>
            <field name="groups" eval="[(4, ref('group_govoo_legal_officer'))]"/>
        </record>

        <record id="purchase_order_legal_officer_rule" model="ir.rule">
            <field name="name">Purchase Order (Bid): Legal Officer sees only bids on Awarded tenders</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">[('govoo_tender_id.evaluation_stage', '=', 'awarded')]</field>
            <field name="groups" eval="[(4, ref('group_govoo_legal_officer'))]"/>
        </record>

        <record id="govoo_minutes_legal_officer_rule" model="ir.rule">
            <field name="name">Minutes: Legal Officer sees only minutes of Awarded tenders</field>
            <field name="model_id" ref="govoo_board.model_govoo_minutes"/>
            <field name="domain_force">[('meeting_id.evaluation_tender_id.evaluation_stage', '=', 'awarded')]</field>
            <field name="groups" eval="[(4, ref('group_govoo_legal_officer'))]"/>
        </record>

<!-- Issue #357: the Procurement Officer may create/manage ANY
             committee-type meeting, not narrowed to "already linked
             to my tender", because a meeting has no evaluation_tender_id
             yet at the moment it's created (the link is stamped on
             afterward, once the tender itself is saved via
             _sync_evaluation_meeting_tender_links in govoo_tender.py),
             so that narrowing is structurally impossible at create
             time. meeting_type == 'committee' is the narrowest thing
             creatable at that point, same breadth-vs-depth tradeoff
             this role already accepts elsewhere (full company-wide
             tender visibility, no "my tenders" concept).

             This is a global rule (no groups field), branched via
             has_group(), so it ANDs with govoo_meeting_comp_rule
             (govoo_board_security.xml) instead of being OR'd away by
             it, the same construction already used by
             govoo_meeting_confidential_comp_rule in that same file for
             an analogous case, reused here rather than inventing a
             different one. Secretary/Admin are exempted (they already
             have broader access via their own ACL) so a dual-role user
             is never narrowed below what their other role already
             grants.

             perm_read is explicitly False: this rule only exists to
             narrow write/create/unlink. Leaving perm_read at its
             default (True) would have silently taken away the
             Officer's existing company-wide READ access to every
             meeting (board, AGM, executive, ...), not just narrowed
             what they can create/edit, confirmed by reading how this
             rule combines with govoo_meeting_comp_rule above (ANDed,
             not OR'd, since this is a global rule). -->

        <record id="govoo_meeting_procurement_officer_rule" model="ir.rule">
            <field name="name">Meeting: Procurement Officer may manage committee-type meetings only</field>
            <field name="model_id" ref="govoo_board.model_govoo_meeting"/>
            <field name="domain_force">[] if not user.has_group('govoo_procurement.group_govoo_procurement_officer') or user.has_group('govoo_base.group_govoo_secretary') or user.has_group('govoo_base.group_govoo_admin') else [('meeting_type', '=', 'committee')]</field>
            <field name="perm_read" eval="False"/>
        </record>

        <!-- Issue #357: Minutes/Agenda Items are narrowed further than
             the meeting itself, only the Financial Evaluation
             meeting specifically, never Technical, per the business's
             own segregation (Technical stays Secretary-only). Relies
             on govoo.meeting.evaluation_phase (govoo_meeting.py), a
             real stored field for the same reason evaluation_tender_id
             is: ir.rule domain_force has no env access for a dynamic
             lookup. Same global-rule/perm_read=False construction as
             the meeting rule above, for the same two reasons. -->
        <record id="govoo_minutes_procurement_officer_rule" model="ir.rule">
            <field name="name">Minutes: Procurement Officer may manage Financial Evaluation minutes only</field>
            <field name="model_id" ref="govoo_board.model_govoo_minutes"/>
            <field name="domain_force">[] if not user.has_group('govoo_procurement.group_govoo_procurement_officer') or user.has_group('govoo_base.group_govoo_secretary') or user.has_group('govoo_base.group_govoo_admin') else [('meeting_id.evaluation_phase', '=', 'financial')]</field>
            <field name="perm_read" eval="False"/>
        </record>

        <record id="govoo_agenda_item_procurement_officer_rule" model="ir.rule">
            <field name="name">Agenda Item: Procurement Officer may manage Financial Evaluation agenda only</field>
            <field name="model_id" ref="govoo_board.model_govoo_agenda_item"/>
            <field name="domain_force">[] if not user.has_group('govoo_procurement.group_govoo_procurement_officer') or user.has_group('govoo_base.group_govoo_secretary') or user.has_group('govoo_base.group_govoo_admin') else [('meeting_id.evaluation_phase', '=', 'financial')]</field>
            <field name="perm_read" eval="False"/>
        </record>
    </data>
</odoo>
