<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_govoo_scores" model="ir.ui.view">
        <field name="name">purchase.order.form.govoo.scores</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="govoo_tender_id"/>
                <field name="tender_evaluation_stage" invisible="1"/>
                <field name="govoo_qualification_status" widget="badge" invisible="not govoo_tender_id"
                       decoration-success="govoo_qualification_status == 'qualified'"
                       decoration-danger="govoo_qualification_status == 'disqualified'"
                       decoration-muted="govoo_qualification_status == 'pending'"/>
                <field name="govoo_disqualification_reason"
                       invisible="govoo_qualification_status != 'disqualified'" readonly="1"/>
                <field name="govoo_technical_score" invisible="not govoo_tender_id"/>
                <field name="govoo_financial_score" invisible="not govoo_tender_id"/>
                <!-- Issue #316: a Procurement Evaluator has read-only
                     access to purchase.order, so the two score fields
                     above render readonly for them, so this button is
                     their only way to actually submit a score, via a
                     narrow wizard that writes nothing else. -->
                <button name="%(action_govoo_bid_score_wizard)d" string="Submit Score" type="action"
                        class="btn-secondary" invisible="not govoo_tender_id"
                        groups="govoo_procurement.group_govoo_procurement_evaluator"
                        context="{'default_bid_id': id}"/>
            </field>
            <!-- Issue #338: the bidder's own submitted documents (not the
                 tender's shared RFQ/TOR, which stays on govoo.tender.
                 document_ids), scoped to this one bid only. Readonly once
                 the parent tender is Awarded, same "don't let the upload
                 widget swallow the backend's rejection silently" UX fix
                 already applied to the tender's own Documents tab. -->
            <page name="purchase_delivery_invoice" position="after">
                <page string="Documents" name="documents" invisible="not govoo_tender_id">
                    <field name="document_ids" widget="many2many_binary"
                           readonly="tender_evaluation_stage == 'awarded'"/>
                </page>
            </page>
        </field>
    </record>
</odoo>
