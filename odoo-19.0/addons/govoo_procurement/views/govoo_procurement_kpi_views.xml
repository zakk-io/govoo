<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tenders had no stat cards at all. Requests for Quotation already
         has Odoo's own native dashboard row; this adds a second,
         Clagov-styled strip beside it (via GovooPurchaseDashBoardRenderer
         in purchase_rfq_kpi.js), not a replacement: the native
         "purchase_dashboard_list" js_class is extended, not dropped, so
         file-upload and the native New/Sent/Late cards keep working. -->
    <record id="view_govoo_tender_list_kpi" model="ir.ui.view">
        <field name="name">govoo.tender.list.kpi</field>
        <field name="model">govoo.tender</field>
        <field name="inherit_id" ref="view_govoo_tender_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">govoo_tender_kpi_list</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_kpis_tree_govoo_kpi" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.govoo.kpi</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">purchase_dashboard_list_govoo_kpi</attribute>
            </xpath>
        </field>
    </record>
</odoo>
