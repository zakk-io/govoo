<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_govoo_tender_list" model="ir.ui.view">
        <field name="name">govoo.tender.list</field>
        <field name="model">govoo.tender</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tender_category_id"/>
                <field name="evaluation_stage"/>
                <field name="bid_count"/>
                <field name="awarded_bid_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_govoo_tender_form" model="ir.ui.view">
        <field name="name">govoo.tender.form</field>
        <field name="model">govoo.tender</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_technical_evaluation" string="Start Technical Evaluation" type="object"
                            class="btn-primary" invisible="evaluation_stage != 'pre_evaluation'"/>
                    <button name="action_start_financial_evaluation" string="Start Financial Evaluation" type="object"
                            class="btn-primary" invisible="evaluation_stage != 'technical_evaluation'"/>
                    <!-- Issue #317/#318: the Procurement Approver's own path
                         to Award, through a narrow wizard that only ever
                         sets the awarded bid and calls action_award(),
                         never grants blanket write access to this record.
                         The old plain "Award" button (direct call,
                         relying on awarded_bid_id already being set) was
                         removed here: #318 blocks the Officer from calling
                         action_award() at all, and the Approver never had
                         write access to set awarded_bid_id directly
                         anyway, so it had no valid user left. -->
                    <button name="%(action_govoo_tender_award_wizard)d" string="Confirm Award" type="action"
                            class="btn-primary" invisible="evaluation_stage != 'financial_evaluation'"
                            groups="govoo_procurement.group_govoo_procurement_approver"
                            context="{'default_tender_id': id}"/>
                    <field name="evaluation_stage" widget="statusbar"
                           statusbar_visible="pre_evaluation,technical_evaluation,financial_evaluation,awarded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_bids" class="oe_stat_button" icon="fa-list-alt">
                            <field name="bid_count" widget="statinfo" string="Vendor Bids"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. RFQ-2026-0001 IT Services Tender"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tender_category_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="submission_deadline"/>
                            <field name="reminder_lead_days" invisible="not submission_deadline"/>
                        </group>
                        <group>
                            <field name="evaluation_meeting_id"/>
                            <field name="evaluation_minutes_id"/>
                            <field name="awarded_bid_id" invisible="evaluation_stage != 'financial_evaluation' and evaluation_stage != 'awarded'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vendor Bids" name="bids">
                            <!-- Issue found alongside the bid-copy feature:
                                 a brand-new, unscored vendor bid should not
                                 be addable once a tender is Awarded, same
                                 lock already applied to document_ids. -->
                            <field name="bid_ids" readonly="evaluation_stage == 'awarded'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="state"/>
                                    <field name="amount_total"/>
                                    <field name="govoo_technical_score"/>
                                    <field name="govoo_financial_score"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documents" name="documents">
                            <!-- Issue #306 UX follow-up: once Awarded, the
                                 model already blocks add/remove on
                                 document_ids (see ir_attachment.py), but a
                                 live check found the widget's own upload
                                 path swallows that rejection silently,
                                 with no error toast, nothing. Making the
                                 field readonly here prevents the user from
                                 ever attempting a change the backend will
                                 reject, instead of letting them hit a
                                 silent dead end. -->
                            <field name="document_ids" widget="many2many_binary"
                                   readonly="evaluation_stage == 'awarded'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Issue #302: the native RFQ list right next to this one in the
         same app has a full curated filter/group-by set; this one had
         none beyond "Custom Filter...", a functional gap against that
         bar. -->
    <record id="view_govoo_tender_search" model="ir.ui.view">
        <field name="name">govoo.tender.search</field>
        <field name="model">govoo.tender</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tender_category_id"/>
                <separator/>
                <filter name="stage_pre_evaluation" string="Pre-Evaluation"
                        domain="[('evaluation_stage', '=', 'pre_evaluation')]"/>
                <filter name="stage_technical_evaluation" string="Technical Evaluation"
                        domain="[('evaluation_stage', '=', 'technical_evaluation')]"/>
                <filter name="stage_financial_evaluation" string="Financial Evaluation"
                        domain="[('evaluation_stage', '=', 'financial_evaluation')]"/>
                <filter name="stage_awarded" string="Awarded"
                        domain="[('evaluation_stage', '=', 'awarded')]"/>
                <separator/>
                <filter name="deadline_this_week" string="Submission Deadline This Week" domain="[
                    ('submission_deadline', '&gt;=', '=week_start'),
                    ('submission_deadline', '&lt;', '=week_start +1w'),
                ]"/>
                <separator/>
                <filter name="group_by_category" string="Tender Category"
                        context="{'group_by': 'tender_category_id'}"/>
                <filter name="group_by_stage" string="Evaluation Stage"
                        context="{'group_by': 'evaluation_stage'}"/>
            </search>
        </field>
    </record>

    <record id="action_govoo_tender" model="ir.actions.act_window">
        <field name="name">Tenders</field>
        <field name="res_model">govoo.tender</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_govoo_tender_search"/>
    </record>

    <menuitem id="menu_govoo_tender"
              name="Tenders"
              parent="purchase.menu_purchase_root"
              action="action_govoo_tender"
              sequence="6"/>

    <!-- Issue #293: the Auditor group can read govoo.tender (via its
         implied govoo_base.group_govoo_user access row) but has no way to
         reach it, since menu_govoo_tender above sits under
         purchase.menu_purchase_root, which is gated to
         group_purchase_manager/group_purchase_user, and the Auditor
         correctly holds neither (both carry write/create rights). This
         gives read-only oversight its own entry point outside that gate,
         without granting any native Purchase group. -->
    <menuitem id="menu_govoo_tender_auditor"
              name="Procurement (Audit View)"
              parent="govoo_base.govoo_menu_root"
              action="action_govoo_tender"
              sequence="70"
              groups="govoo_base.group_govoo_auditor"/>

    <!-- Issue #316/#317: Evaluator and Approver work inside the real
         Procurement app, not a separate standalone view; unlike the
         Auditor (whose group has no other reason to touch Purchase), these
         two roles need the actual Tenders/Vendor Bids navigation. Adding
         their groups to the native Purchase app's own menu_purchase_root
         only affects menu visibility, never model access: their ACL rows
         (ir.model.access.csv) stay strictly read-only regardless, since
         Odoo access rights are additive across every group a user holds,
         never narrowed back down by a separate group. Deliberately NOT
         implying purchase.group_purchase_user on these roles, since that
         group's own native ACL row grants write/create on purchase.order,
         which no combination of additional groups could claw back. -->
    <record id="purchase.menu_purchase_root" model="ir.ui.menu">
        <field name="group_ids" eval="[
            (4, ref('govoo_procurement.group_govoo_procurement_evaluator')),
            (4, ref('govoo_procurement.group_govoo_procurement_approver')),
        ]"/>
    </record>

    <!-- The Procurement Officer needs to reach vendors as actual contacts
         (not just the tender-linked bid form) and needs Discuss to field
         vendor correspondence. Both native apps are already restricted to
         Administrator-only in this deployment (not something this module
         set up, found as-is); adding the Officer's own group here is
         additive only; every other role's access to these two apps is
         unchanged. -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('govoo_procurement.group_govoo_procurement_officer'))]"/>
    </record>

    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('govoo_procurement.group_govoo_procurement_officer'))]"/>
    </record>

    <!-- Issue: the Officer's day-to-day vendor work is with companies, not
         the individual people contacts other governance roles use this
         same app for (e.g. Board Directors). A dedicated, company-only
         entry point avoids making the Officer wade through unrelated
         person contacts every time, without touching the shared
         "Contacts" entry above (still unfiltered, as every other role
         that can reach it expects). -->
    <record id="action_govoo_vendor_companies" model="ir.actions.act_window">
        <field name="name">Vendor Companies</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_company', '=', True)]</field>
        <field name="context">{'default_is_company': True, 'default_supplier_rank': 1}</field>
    </record>

    <menuitem id="menu_govoo_vendor_companies"
              name="Vendor Companies"
              parent="contacts.menu_contacts"
              action="action_govoo_vendor_companies"
              sequence="1"
              groups="govoo_procurement.group_govoo_procurement_officer"/>
</odoo>
