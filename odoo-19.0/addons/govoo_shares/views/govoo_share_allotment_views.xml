<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_share_allotment_view_list" model="ir.ui.view">
        <field name="name">govoo.share.allotment.list</field>
        <field name="model">govoo.share.allotment</field>
        <field name="arch" type="xml">
            <list>
                <field name="share_class_id"/>
                <field name="partner_id"/>
                <field name="quantity"/>
                <field name="price_per_share" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="date_allotted"/>
                <field name="certificate_no"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_share_allotment_view_form" model="ir.ui.view">
        <field name="name">govoo.share.allotment.form</field>
        <field name="model">govoo.share.allotment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="share_class_id"/>
                            <field name="partner_id"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="price_per_share" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="date_allotted"/>
                            <field name="certificate_no"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Certificate"
                           groups="govoo_base.group_govoo_secretary">
                        <field name="certificate_document_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="govoo_share_allotment_view_search" model="ir.ui.view">
        <field name="name">govoo.share.allotment.search</field>
        <field name="model">govoo.share.allotment</field>
        <field name="arch" type="xml">
            <search>
                <field name="share_class_id"/>
                <field name="partner_id"/>
                <group>
                    <filter name="group_class" string="Share Class"
                            context="{'group_by': 'share_class_id'}"/>
                    <filter name="group_partner" string="Allottee"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="govoo_share_allotment_action" model="ir.actions.act_window">
        <field name="name">Allotments</field>
        <field name="res_model">govoo.share.allotment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
