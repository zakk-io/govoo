<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_share_class_view_list" model="ir.ui.view">
        <field name="name">govoo.share.class.list</field>
        <field name="model">govoo.share.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="nominal_value" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="votes_per_share"/>
                <field name="total_authorised"/>
                <field name="total_allotted"/>
                <field name="is_redeemable" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Issue #251: share class had no kanban view at all. No state field
         on this model, so the progress bar (shares allotted vs authorised)
         is the card's main at-a-glance indicator instead of a colour-coded
         status. -->
    <record id="govoo_share_class_view_kanban" model="ir.ui.view">
        <field name="name">govoo.share.class.kanban</field>
        <field name="model">govoo.share.class</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="nominal_value"/>
                <field name="currency_id"/>
                <field name="votes_per_share"/>
                <field name="total_authorised"/>
                <field name="total_allotted"/>
                <field name="holding_count"/>
                <templates>
                    <t t-name="card">
                        <t t-set="govoo_pct" t-value="record.total_authorised.raw_value ? Math.min(100, Math.round(record.total_allotted.raw_value / record.total_authorised.raw_value * 100)) : false"/>
                        <div class="border-start border-4 border-primary ps-2">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <span class="text-muted d-block">
                                        Nominal value: <field name="nominal_value" widget="monetary"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body" t-if="govoo_pct !== false">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Allotted</span>
                                    <span><t t-esc="record.total_allotted.raw_value"/> / <t t-esc="record.total_authorised.raw_value"/></span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" t-attf-style="width: {{govoo_pct}}%"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge text-bg-light" t-if="record.holding_count.raw_value">
                                        <i class="fa fa-address-book-o me-1"/><t t-esc="record.holding_count.raw_value"/> holders
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="govoo_share_class_view_form" model="ir.ui.view">
        <field name="name">govoo.share.class.form</field>
        <field name="model">govoo.share.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_allotments" type="object"
                                class="oe_stat_button" icon="fa-share"
                                invisible="not allotment_count">
                            <field name="allotment_count" widget="statinfo" string="Allotments"/>
                        </button>
                        <button name="action_view_transfers" type="object"
                                class="oe_stat_button" icon="fa-exchange"
                                invisible="not transfer_count">
                            <field name="transfer_count" widget="statinfo" string="Transfers"/>
                        </button>
                        <button name="action_view_holders" type="object"
                                class="oe_stat_button" icon="fa-address-book-o"
                                invisible="not holding_count">
                            <field name="holding_count" widget="statinfo" string="Holders"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="nominal_value" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="votes_per_share"/>
                            <field name="total_authorised"/>
                            <field name="total_allotted"/>
                            <field name="is_redeemable"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Holdings" name="holdings">
                            <field name="holding_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="govoo_share_class_action" model="ir.actions.act_window">
        <field name="name">Share Classes</field>
        <field name="res_model">govoo.share.class</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

</odoo>
