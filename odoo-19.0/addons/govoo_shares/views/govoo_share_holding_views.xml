<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_share_holding_view_list" model="ir.ui.view">
        <field name="name">govoo.share.holding.list</field>
        <field name="model">govoo.share.holding</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="share_class_id"/>
                <field name="partner_id"/>
                <field name="quantity"/>
                <field name="percentage" widget="progressbar"/>
                <field name="voting_power" options="{'hide_trailing_zeros': True}"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_share_holding_view_form" model="ir.ui.view">
        <field name="name">govoo.share.holding.form</field>
        <field name="model">govoo.share.holding</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="share_class_id"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="percentage"/>
                            <field name="voting_power" options="{'hide_trailing_zeros': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="govoo_share_holding_action" model="ir.actions.act_window">
        <field name="name">Cap Table</field>
        <field name="res_model">govoo.share.holding</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>

</odoo>
