<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Issue #236: these only fire once the corresponding
             ir.config_parameter deadline is explicitly set by an admin,
             see govoo_shares_cron.py for the [CONFIRM] discipline. -->

        <record id="mail_template_certificate_issuance_reminder" model="mail.template">
            <field name="name">Share Allotment: Certificate Issuance Reminder</field>
            <field name="model_id" ref="model_govoo_share_allotment"/>
            <field name="subject">Share certificate issuance deadline approaching</field>
            <field name="description">Sent to Company Secretaries when an allotment nears its certificate-issuance deadline (issue #236)</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>
        Hello,<br/><br/>
        <strong t-out="object.partner_id.name or ''">Shareholder</strong> was allotted
        <t t-out="object.quantity or ''">qty</t> shares on
        <t t-out="object.date_allotted or ''">date</t>, and still needs a share
        certificate issued -- the issuance deadline is approaching.
    </p>
    <div style="text-align: center; padding: 16px 0px 16px 0px;">
        <a t-attf-href="/odoo/govoo.share.allotment/{{ object.id }}"
           style="padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px">
            View Allotment</a>
    </div>
</div>
            </field>
        </record>

        <record id="mail_template_transfer_registration_reminder" model="mail.template">
            <field name="name">Share Transfer: Registration Reminder</field>
            <field name="model_id" ref="model_govoo_share_transfer"/>
            <field name="subject">Share transfer registration deadline approaching</field>
            <field name="description">Sent to Company Secretaries when a transfer nears its registration deadline (issue #236)</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>
        Hello,<br/><br/>
        The transfer of <t t-out="object.quantity or ''">qty</t> shares from
        <strong t-out="object.transferor_id.name or ''">Transferor</strong> to
        <strong t-out="object.transferee_id.name or ''">Transferee</strong>
        (dated <t t-out="object.date_transferred or ''">date</t>) still needs to be
        registered -- the registration deadline is approaching.
    </p>
    <div style="text-align: center; padding: 16px 0px 16px 0px;">
        <a t-attf-href="/odoo/govoo.share.transfer/{{ object.id }}"
           style="padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px">
            View Transfer</a>
    </div>
</div>
            </field>
        </record>

    </data>
</odoo>
