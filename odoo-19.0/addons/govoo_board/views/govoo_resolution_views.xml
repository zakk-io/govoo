<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_resolution_view_list" model="ir.ui.view">
        <field name="name">govoo.resolution.list</field>
        <field name="model">govoo.resolution</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'passed'"
                  decoration-danger="state == 'failed'"
                  decoration-info="state == 'open'"
                  decoration-muted="state == 'withdrawn'"
                  default_group_by="state">
                <field name="title"/>
                <field name="resolution_type"/>
                <field name="meeting_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'passed'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'open'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'withdrawn'"/>
                <field name="result"/>
                <field name="effective_date"/>
            </list>
        </field>
    </record>

    <record id="govoo_resolution_view_form" model="ir.ui.view">
        <field name="name">govoo.resolution.form</field>
        <field name="model">govoo.resolution</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" string="Open for Voting"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_tally" string="Tally Votes"
                            type="object" class="oe_highlight"
                            invisible="state != 'open'"/>
                    <button name="action_withdraw" string="Withdraw"
                            type="object"
                            invisible="state in ('passed', 'failed', 'withdrawn')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_votes" type="object"
                                class="oe_stat_button" icon="fa-check-square-o"
                                invisible="not vote_count">
                            <field name="vote_count" widget="statinfo" string="Votes"/>
                        </button>
                    </div>
                    <field name="unreachable_voter_count" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not unreachable_voter_count">
                        <field name="unreachable_voter_count"/> eligible voter(s) could not be notified by email
                        (no usable email on file to auto-create portal access) -- see the Voting Notifications tab below.
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="resolution_type"/>
                            <field name="meeting_id"/>
                            <field name="agenda_item_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="effective_date"/>
                            <field name="result"/>
                            <field name="sign_request_id"/>
                        </group>
                    </group>
                    <group string="Resolution Text">
                        <field name="text" placeholder="Resolution text..."/>
                    </group>
                    <notebook>
                        <page string="Votes" name="votes">
                            <field name="vote_ids">
                                <list editable="bottom">
                                    <field name="voter_id"/>
                                    <field name="choice"/>
                                    <field name="weight" options="{'hide_trailing_zeros': True}"/>
                                    <field name="is_conflicted"/>
                                    <field name="timestamp"/>
                                </list>
                            </field>
                        </page>
                        <page string="Voting Notifications" name="voter_notifications">
                            <field name="voter_notification_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="voter_type"/>
                                    <field name="has_portal_access"/>
                                    <field name="notified_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="govoo_resolution_view_kanban" model="ir.ui.view">
        <field name="name">govoo.resolution.kanban</field>
        <field name="model">govoo.resolution</field>
        <field name="arch" type="xml">
            <!-- Issue #251: colour bar + single badge + vote-tally progress
                 bar (shown only while open for voting) + quick-action menu.
                 No new Python fields: vote_count and voter_notification_ids
                 already exist on the model. -->
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="title"/>
                <field name="state"/>
                <field name="resolution_type"/>
                <field name="meeting_id"/>
                <field name="vote_count"/>
                <field name="voter_notification_ids"/>
                <templates>
                    <t t-name="card">
                        <t t-set="govoo_color" t-value="record.state.raw_value == 'passed' ? 'success' : (record.state.raw_value == 'failed' ? 'danger' : (record.state.raw_value == 'open' ? 'info' : (record.state.raw_value == 'withdrawn' ? 'secondary' : 'warning')))"/>
                        <t t-set="govoo_total_voters" t-value="record.voter_notification_ids.raw_value.length"/>
                        <div t-attf-class="border-start border-4 border-{{govoo_color}} ps-2">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="title"/></strong>
                                    <span class="text-muted d-block"><field name="meeting_id"/></span>
                                </div>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'passed'"
                                       decoration-danger="state == 'failed'"
                                       decoration-info="state == 'open'"
                                       decoration-warning="state == 'draft'"
                                       decoration-muted="state == 'withdrawn'"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="badge text-bg-light"><field name="resolution_type"/></span>
                            </div>
                            <div class="o_kanban_record_body" t-if="record.state.raw_value == 'open' and govoo_total_voters">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Votes cast</span>
                                    <span><t t-esc="record.vote_count.raw_value"/> / <t t-esc="govoo_total_voters"/></span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-info"
                                         t-attf-style="width: {{Math.round(record.vote_count.raw_value / govoo_total_voters * 100)}}%"/>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="govoo_resolution_action" model="ir.actions.act_window">
        <field name="name">Resolutions</field>
        <field name="res_model">govoo.resolution</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

</odoo>
