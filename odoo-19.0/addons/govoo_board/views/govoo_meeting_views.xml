<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_meeting_view_list" model="ir.ui.view">
        <field name="name">govoo.meeting.list</field>
        <field name="model">govoo.meeting</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ('held', 'minuted', 'closed')"
                  decoration-info="state == 'scheduled'"
                  decoration-warning="state == 'draft'"
                  default_group_by="committee_id">
                <field name="name"/>
                <field name="meeting_type"/>
                <field name="committee_id"/>
                <field name="date"/>
                <field name="quorum_met"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('held', 'minuted', 'closed')"
                       decoration-info="state == 'scheduled'"
                       decoration-warning="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_meeting_view_form" model="ir.ui.view">
        <field name="name">govoo.meeting.form</field>
        <field name="model">govoo.meeting</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" string="Schedule"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_hold" string="Mark as Held"
                            type="object" class="oe_highlight"
                            invisible="state != 'scheduled'"/>
                    <button name="action_minute" string="Mark as Minuted"
                            type="object" class="oe_highlight"
                            invisible="state != 'held'"/>
                    <button name="action_close" string="Close Meeting"
                            type="object" class="oe_highlight"
                            invisible="state != 'minuted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <!-- Issue #253: web_ribbon (OCA) isn't in this install's
                         addons path, so this is a small native equivalent
                         (see govoo_base/static/src/scss/ribbon.scss). -->
                    <div class="o_ribbon bg-success" invisible="state != 'closed'">Closed</div>
                    <div class="oe_button_box" name="button_box">
                        <!-- Agenda has no smart button: docs/spec/ui/views.md's
                             govoo.agenda.item row requires an inline editable
                             list on this form, which the Agenda tab below
                             provides directly; a smart button here would
                             just be a second, read-only path to the same
                             data (issue #151). -->
                        <button name="action_view_pack" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="not pack_count">
                            <field name="pack_count" widget="statinfo" string="Pack"/>
                        </button>
                        <button name="action_view_minutes" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not minutes_count">
                            <field name="minutes_count" widget="statinfo" string="Minutes"/>
                        </button>
                        <button name="action_view_resolutions" type="object"
                                class="oe_stat_button" icon="fa-balance-scale"
                                invisible="not resolution_count">
                            <field name="resolution_count" widget="statinfo" string="Resolutions"/>
                        </button>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="pack_id">
                        No board pack has been compiled for this meeting yet.
                        <button name="action_create_pack" type="object"
                                string="Compile Board Pack" class="btn-link"
                                groups="govoo_base.group_govoo_secretary"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="minutes_id">
                        Minutes have not been drafted yet.
                        <button name="action_create_minutes" type="object"
                                string="Draft Minutes" class="btn-link"
                                groups="govoo_base.group_govoo_secretary"/>
                    </div>
                    <!-- Issue #273: Pack/Minutes already had this empty-
                         state call-to-action; Resolutions previously had
                         no in-context way to create the first one. -->
                    <div class="alert alert-info" role="alert" invisible="resolution_count">
                        No resolutions have been proposed yet.
                        <button name="action_create_resolution" type="object"
                                string="Draft Resolution" class="btn-link"
                                groups="govoo_base.group_govoo_secretary"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="meeting_type"/>
                            <field name="committee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="location"/>
                            <field name="virtual_link"/>
                            <field name="quorum_required"
                                   help="Minimum number of attendees required for this meeting's resolutions to be valid, per the committee's terms of reference or the Articles of Association."/>
                            <field name="quorum_met"
                                   help="Whether the quorum requirement above was actually met once the meeting was held. Resolutions passed without quorum may be challengeable."/>
                        </group>
                    </group>
                    <group string="Attendees">
                        <field name="attendee_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <!-- Pack, Minutes, and Resolutions are reachable via
                             their smart buttons above only; see issue #151
                             (they used to also have a notebook tab here,
                             duplicating the same data via a second
                             navigation idiom). -->
                        <page string="Agenda" name="agenda">
                            <field name="agenda_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="govoo_meeting_view_kanban" model="ir.ui.view">
        <field name="name">govoo.meeting.kanban</field>
        <field name="model">govoo.meeting</field>
        <field name="arch" type="xml">
            <!-- Issue #251: rich card — colour bar, title+subtitle, single
                 status badge, date chip, agenda/resolution counts, quick-
                 action menu. The <kanban> root tag has no decoration-*
                 support at all (confirmed empirically against this exact
                 Odoo version while building #252/#260's dashboard kanban,
                 only <list> and individual <field> elements parse it), so
                 the colour bar is a plain Bootstrap border-utility class
                 computed via t-set, the same technique already proven for
                 the #252/#261 KPI strip tiles. -->
            <kanban class="o_kanban_mobile" default_group_by="committee_id">
                <field name="name"/>
                <field name="state"/>
                <field name="date"/>
                <field name="committee_id"/>
                <field name="agenda_count"/>
                <field name="resolution_count"/>
                <templates>
                    <t t-name="card">
                        <t t-set="govoo_color" t-value="['held', 'minuted', 'closed'].includes(record.state.raw_value) ? 'success' : (record.state.raw_value == 'scheduled' ? 'info' : 'warning')"/>
                        <div t-attf-class="border-start border-4 border-{{govoo_color}} ps-2">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <span class="text-muted d-block"><field name="committee_id"/></span>
                                </div>
                                <field name="state" widget="badge"
                                       decoration-success="state in ('held', 'minuted', 'closed')"
                                       decoration-info="state == 'scheduled'"
                                       decoration-warning="state == 'draft'"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="o_kanban_record_line">
                                    <i class="fa fa-calendar me-1" title="Date"/>
                                    <field name="date"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge text-bg-light me-1" t-if="record.agenda_count.raw_value">
                                        <i class="fa fa-list-ul me-1"/><t t-esc="record.agenda_count.raw_value"/> agenda
                                    </span>
                                    <span class="badge text-bg-light" t-if="record.resolution_count.raw_value">
                                        <i class="fa fa-balance-scale me-1"/><t t-esc="record.resolution_count.raw_value"/> resolutions
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="govoo_meeting_view_search" model="ir.ui.view">
        <field name="name">govoo.meeting.search</field>
        <field name="model">govoo.meeting</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="committee_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_scheduled" string="Scheduled"
                        domain="[('state', '=', 'scheduled')]"/>
                <filter name="filter_held" string="Held"
                        domain="[('state', '=', 'held')]"/>
                <separator/>
                <!-- Odoo's date-filter default_period only accepts "year",
                     "month" (each optionally with a +/-N offset), or one of
                     the four named quarters — there's no generic "current
                     quarter" shorthand, and hardcoding e.g. "third_quarter"
                     would silently go stale next quarter. -->
                <filter name="filter_date" string="Date"
                        date="date" default_period="month"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Meeting Type"
                            context="{'group_by': 'meeting_type'}"/>
                    <filter name="group_committee" string="Committee"
                            context="{'group_by': 'committee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="govoo_meeting_view_calendar" model="ir.ui.view">
        <field name="name">govoo.meeting.calendar</field>
        <field name="model">govoo.meeting</field>
        <field name="arch" type="xml">
            <!-- Issue #253: colour-code by committee (meetings have no RAG
                 status of their own). -->
            <calendar date_start="date" date_stop="date_end"
                      string="Meetings" event_open_popup="1"
                      color="committee_id">
                <field name="name"/>
                <field name="date"/>
                <field name="date_end"/>
                <field name="committee_id" filters="1"/>
            </calendar>
        </field>
    </record>

    <!-- Issue #253: search_view_id pinned explicitly. Without it, Odoo's
         default-view auto-selection was silently picking govoo_portal's
         minimal dashboard-widget search view (govoo_dashboard_meeting_search,
         loaded later since govoo_portal depends on govoo_board) over this
         module's own, fuller one; same empirically-confirmed-not-guessed
         shape of bug as #251's Votes-smart-button view_mode fix. -->
    <record id="govoo_meeting_action" model="ir.actions.act_window">
        <field name="name">Meetings</field>
        <field name="res_model">govoo.meeting</field>
        <field name="view_mode">list,form,kanban,calendar</field>
        <field name="search_view_id" ref="govoo_meeting_view_search"/>
    </record>

</odoo>
