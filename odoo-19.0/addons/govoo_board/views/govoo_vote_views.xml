<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vote is inline on resolution form; this view provides list for portal/readonly context -->
    <record id="govoo_vote_view_list" model="ir.ui.view">
        <field name="name">govoo.vote.list</field>
        <field name="model">govoo.vote</field>
        <field name="arch" type="xml">
            <list create="0" edit="0"
                  decoration-success="choice == 'for'"
                  decoration-danger="choice == 'against'"
                  decoration-warning="choice == 'abstain'">
                <field name="voter_id"/>
                <field name="cast_by_id" string="Cast By (Proxy)"/>
                <field name="choice" widget="badge"
                       decoration-success="choice == 'for'"
                       decoration-danger="choice == 'against'"
                       decoration-warning="choice == 'abstain'"/>
                <field name="weight" options="{'hide_trailing_zeros': True}"/>
                <field name="is_conflicted" widget="boolean_toggle"/>
                <field name="timestamp"/>
            </list>
        </field>
    </record>

    <record id="govoo_vote_view_kanban" model="ir.ui.view">
        <field name="name">govoo.vote.kanban</field>
        <field name="model">govoo.vote</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" class="o_kanban_mobile">
                <field name="voter_id"/>
                <field name="choice"/>
                <field name="weight"/>
                <templates>
                    <t t-name="card">
                        <t t-set="govoo_color" t-value="record.choice.raw_value == 'for' ? 'success' : (record.choice.raw_value == 'against' ? 'danger' : 'warning')"/>
                        <div t-attf-class="border-start border-4 border-{{govoo_color}} ps-2 d-flex align-items-center">
                            <field name="voter_id" widget="many2one_avatar" class="me-2"/>
                            <div class="flex-grow-1">
                                <strong class="o_kanban_record_title d-block"><field name="voter_id"/></strong>
                                <field name="weight" options="{'hide_trailing_zeros': True}"/>
                            </div>
                            <field name="choice" widget="badge"
                                   decoration-success="choice == 'for'"
                                   decoration-danger="choice == 'against'"
                                   decoration-warning="choice == 'abstain'"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="govoo_vote_action" model="ir.actions.act_window">
        <field name="name">Votes</field>
        <field name="res_model">govoo.vote</field>
        <field name="view_mode">list,kanban</field>
    </record>

</odoo>
