<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Issue #203: sent to each recipient when a board pack is
             distributed, in addition to (not instead of) the existing
             in-app portal notification. Links to the recipient's own
             portal copy of the pack (govoo_portal's
             /my/meetings/<id>/pack route) rather than attaching a raw
             PDF: that route regenerates a per-recipient, correctly
             redacted copy on every request (BR-BOARD-003), which a
             cached email attachment could never do; attaching the
             master document_id here would leak confidential agenda
             items to recipients not authorized to see them. -->
        <record id="mail_template_board_pack_distribution" model="mail.template">
            <field name="name">Board Pack: Distribution</field>
            <field name="model_id" ref="model_govoo_board_pack_recipient"/>
            <field name="subject">Board pack available: {{ object.pack_id.meeting_id.name }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="description">Sent to each recipient when a board pack is distributed (issue #203)</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>
        Hello <t t-out="object.partner_id.name or ''">Director</t>,<br/><br/>
        The board pack for <strong t-out="object.pack_id.meeting_id.name or ''">Board Meeting</strong> is ready for your review.
    </p>
    <div style="text-align: center; padding: 16px 0px 16px 0px;">
        <a t-attf-href="{{ object.pack_id.meeting_id.get_portal_url(suffix='/pack') }}"
           style="padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px">
            View Your Board Pack</a>
    </div>
    <p>
        This link opens your own copy of the pack, showing only the items you are authorized to see.
    </p>
</div>
            </field>
        </record>

        <!-- Issue #234: sent to each eligible voter when a resolution
             opens for voting, in addition to the existing in-app
             activity/notification. Links to the voter's own correct
             casting route, director or shareholder, rather than a
             single generic link, since govoo.resolution has no one route
             that works for both (see govoo.resolution.voter.portal_url). -->
        <record id="mail_template_resolution_voting_invite" model="mail.template">
            <field name="name">Resolution: Voting Invite</field>
            <field name="model_id" ref="model_govoo_resolution_voter"/>
            <field name="subject">Your vote is requested: {{ object.resolution_id.title }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="description">Sent to each eligible voter when a resolution opens for voting (issue #234)</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>
        Hello <t t-out="object.partner_id.name or ''">Voter</t>,<br/><br/>
        A resolution is now open for voting: <strong t-out="object.resolution_id.title or ''">Resolution</strong>.
    </p>
    <div style="text-align: center; padding: 16px 0px 16px 0px;">
        <a t-attf-href="{{ object.portal_url }}"
           style="padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px">
            Cast Your Vote</a>
    </div>
    <p>
        This link opens the resolution so you can record your vote.
    </p>
</div>
            </field>
        </record>

    </data>
</odoo>
