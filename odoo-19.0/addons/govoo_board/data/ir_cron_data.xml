<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Issue #269 item 3: only acts on resolutions that actually have
             a vote_deadline, which only happens once
             'govoo_board.resolution_voting_window_days' is configured. -->
        <record id="cron_close_expired_resolutions" model="ir.cron">
            <field name="name">Board: Auto-Close Expired Resolution Votes</field>
            <field name="model_id" ref="model_govoo_board_cron"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_expired_resolutions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

    </data>
</odoo>
