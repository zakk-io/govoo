<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_clagov" model="report.paperformat">
        <field name="name">CLAGOV A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">70</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <!-- Odoo 19's zero-height header document uses margin_top - spacing
             as its physical origin: 70 - 58 = 12 mm. -->
        <field name="header_spacing">58</field>
        <field name="css_margins" eval="False"/>
        <field name="dpi">90</field>
    </record>
    <!-- Primary inheritance creates a new layout. It does not modify the standard
         company report layout or force branding onto invoices/legal documents. -->
    <template id="external_layout_standard" inherit_id="web.external_layout_standard" primary="True" name="CLAGOV report layout">
        <xpath expr="//div[contains(@t-attf-class, 'header')]" position="attributes">
            <attribute name="t-attf-class" add="o_clagov_report" separator=" "/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'article')]" position="attributes">
            <attribute name="t-attf-class" add="o_clagov_report" separator=" "/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer')]" position="attributes">
            <attribute name="t-attf-class" add="o_clagov_report" separator=" "/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'header')]/div[1]" position="before">
            <div class="clagov_report_brand">
                <img src="/clagov_brand_theme/static/src/img/lockup.png" alt="Clagov" height="36"/>
            </div>
        </xpath>
    </template>

    <template id="external_layout" name="CLAGOV external layout (opt in)">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id" t-set="company" t-value="company_id"/>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()" t-set="company" t-value="o.company_id.sudo()"/>
            <t t-else="" t-set="company" t-value="res_company"/>
        </t>
        <t t-call="clagov_brand_theme.external_layout_standard"><t t-out="0"/></t>
    </template>
</odoo>
