<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_govoo_ai_search_wizard_form" model="ir.ui.view">
        <field name="name">govoo.ai.search.wizard.form</field>
        <field name="model">govoo.ai.search.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Search Governance Records</h1>
                    </div>
                    <group>
                        <field name="query" nolabel="1" placeholder="e.g. When did we last amend the Articles of Association?"
                               readonly="state == 'done'"/>
                    </group>
                    <footer invisible="state != 'draft'">
                        <button name="action_search" string="Search" type="object" class="btn-primary"/>
                    </footer>
                    <group string="Results" invisible="state != 'done'">
                        <field name="result_count" invisible="1"/>
                        <div class="alert alert-info" role="alert" invisible="result_count != 0">
                            No matching records were found in the data available to you.
                        </div>
                        <field name="result_ids" nolabel="1" invisible="result_count == 0">
                            <list no_open="1">
                                <field name="target_model"/>
                                <field name="content" widget="text"/>
                                <button name="action_open_target" string="Open" type="object" icon="fa-external-link"/>
                            </list>
                        </field>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="state != 'done'">
                        AI-generated, grounded in your own records. Not legal advice.
                    </div>
                    <footer invisible="state != 'done'">
                        <button name="action_reset" string="Search Again" type="object" class="btn-secondary"/>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_govoo_ai_search_wizard" model="ir.actions.act_window">
        <field name="name">Search Governance Records</field>
        <field name="res_model">govoo.ai.search.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
