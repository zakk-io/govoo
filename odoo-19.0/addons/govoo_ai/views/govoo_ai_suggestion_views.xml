<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_govoo_ai_suggestion_list" model="ir.ui.view">
        <field name="name">govoo.ai.suggestion.list</field>
        <field name="model">govoo.ai.suggestion</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="create_date"/>
                <field name="request_id"/>
                <field name="target_model"/>
                <field name="confidence"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_govoo_ai_suggestion_form" model="ir.ui.view">
        <field name="name">govoo.ai.suggestion.form</field>
        <field name="model">govoo.ai.suggestion</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_accept" string="Accept" type="object"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,accepted,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="target_model"/>
                            <field name="target_res_id"/>
                            <field name="confidence"/>
                        </group>
                        <group>
                            <field name="reviewed_by"/>
                            <field name="reviewed_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Suggested Content" name="content">
                            <field name="content"/>
                        </page>
                        <page string="Citations" name="citations">
                            <field name="citations" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_govoo_ai_suggestion_search" model="ir.ui.view">
        <field name="name">govoo.ai.suggestion.search</field>
        <field name="model">govoo.ai.suggestion</field>
        <field name="arch" type="xml">
            <search>
                <field name="target_model"/>
                <field name="request_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_govoo_ai_suggestion" model="ir.actions.act_window">
        <field name="name">AI Suggestions</field>
        <field name="res_model">govoo.ai.suggestion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
