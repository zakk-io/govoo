<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI-F07 direct-upload fields: one per extraction target (see
         EXTRACTION_FIELD_MAP in models/govoo_ai_extraction.py), added by
         inheriting the target module's own form view from here rather
         than editing that module's view file. govoo_secretarial/
         govoo_shares/govoo_contracts/govoo_base stay unaware of AI
         features; govoo_ai depends on them, never the reverse.

         No "Scan Document" button here (issue #233): uploading or
         selecting a document into the field below already triggers
         extraction automatically via that model's own onchange
         (govoo_ai_extraction_targets.py) when AI-F07 is enabled, so a
         separate button became redundant. The "AI > Extract from
         Document" menu's wizard remains as the fallback for when AI-F07
         is disabled, or as an explicit redo. -->

    <record id="govoo_appointment_view_form_ai_extraction" model="ir.ui.view">
        <field name="name">govoo.appointment.form.ai.extraction</field>
        <field name="model">govoo.appointment</field>
        <field name="inherit_id" ref="govoo_base.govoo_appointment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='appointment_document_id']" position="after">
                <field name="appointment_document_upload" filename="appointment_document_upload_filename"/>
                <field name="appointment_document_upload_filename" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="govoo_register_beneficial_owner_view_form_ai_extraction" model="ir.ui.view">
        <field name="name">govoo.register.beneficial.owner.form.ai.extraction</field>
        <field name="model">govoo.register.beneficial.owner</field>
        <field name="inherit_id" ref="govoo_secretarial.govoo_register_beneficial_owner_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='evidence_document_id']" position="after">
                <field name="evidence_document_upload" filename="evidence_document_upload_filename"/>
                <field name="evidence_document_upload_filename" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="govoo_register_charge_view_form_ai_extraction" model="ir.ui.view">
        <field name="name">govoo.register.charge.form.ai.extraction</field>
        <field name="model">govoo.register.charge</field>
        <field name="inherit_id" ref="govoo_secretarial.govoo_register_charge_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='charge_document_id']" position="after">
                <field name="charge_document_upload" filename="charge_document_upload_filename"/>
                <field name="charge_document_upload_filename" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="govoo_share_allotment_view_form_ai_extraction" model="ir.ui.view">
        <field name="name">govoo.share.allotment.form.ai.extraction</field>
        <field name="model">govoo.share.allotment</field>
        <field name="inherit_id" ref="govoo_shares.govoo_share_allotment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='certificate_document_id']" position="after">
                <field name="certificate_document_upload" filename="certificate_document_upload_filename"/>
                <field name="certificate_document_upload_filename" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="govoo_share_transfer_view_form_ai_extraction" model="ir.ui.view">
        <field name="name">govoo.share.transfer.form.ai.extraction</field>
        <field name="model">govoo.share.transfer</field>
        <field name="inherit_id" ref="govoo_shares.govoo_share_transfer_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='transfer_instrument_id']" position="after">
                <field name="transfer_instrument_upload" filename="transfer_instrument_upload_filename"/>
                <field name="transfer_instrument_upload_filename" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
