<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_govoo_ai_request_list" model="ir.ui.view">
        <field name="name">govoo.ai.request.list</field>
        <field name="model">govoo.ai.request</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/>
                <field name="feature"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="model_name"/>
                <field name="token_usage" sum="Total"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_govoo_ai_request_form" model="ir.ui.view">
        <field name="name">govoo.ai.request.form</field>
        <field name="model">govoo.ai.request</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="feature"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="status" widget="statusbar" statusbar_visible="queued,done"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="token_usage"/>
                            <field name="input_ref"/>
                            <field name="output_ref"/>
                        </group>
                    </group>
                    <group string="Input Summary (Redacted)">
                        <field name="input_summary" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_govoo_ai_request" model="ir.actions.act_window">
        <field name="name">AI Requests</field>
        <field name="res_model">govoo.ai.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
