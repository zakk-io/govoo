<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Activate RWF with 0 decimal places (legally required for RWF) -->
    <record id="base.RWF" model="res.currency">
        <field name="active" eval="True"/>
        <field name="rounding">1</field>
        <field name="symbol">FRw</field>
    </record>

    <!-- Activate UGX as secondary currency (East African Community) -->
    <record id="base.UGX" model="res.currency">
        <field name="active" eval="True"/>
    </record>

</odoo>
