<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Weekly cron: check retention expiry and flag records for disposal -->
    <record id="cron_check_retention_disposal" model="ir.cron">
        <field name="name">Retention: Check Disposal</field>
        <field name="model_id" ref="model_govoo_rw_retention"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_disposal()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
    </record>

</odoo>
