<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Rwanda Compliance Obligation Templates                        -->
    <!-- All records active=False until advisor confirmation           -->
    <!-- BR-COMP-001, BR-RW-002                                        -->
    <!-- [CONFIRM] All rates, dates, and thresholds are provisional    -->
    <!-- ============================================================ -->

    <!-- Monthly obligations (15th of following month) -->

    <record id="obligation_vat_monthly" model="govoo.compliance.obligation">
        <field name="name">VAT Return (Monthly)</field>
        <field name="authority">RRA</field>
        <field name="frequency">monthly</field>
        <field name="basis">fixed_date</field>
        <field name="fixed_day">15</field>
        <field name="fixed_month">1</field>
        <field name="lead_time_days">7</field>
        <field name="applies_to_entity_type">company</field>
        <field name="active">False</field>
    </record>

    <record id="obligation_paye_monthly" model="govoo.compliance.obligation">
        <field name="name">PAYE Return (Monthly)</field>
        <field name="authority">RRA</field>
        <field name="frequency">monthly</field>
        <field name="basis">fixed_date</field>
        <field name="fixed_day">15</field>
        <field name="fixed_month">1</field>
        <field name="lead_time_days">7</field>
        <field name="applies_to_entity_type">company</field>
        <field name="active">False</field>
    </record>

