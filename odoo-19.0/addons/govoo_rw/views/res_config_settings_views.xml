<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend the general settings form with Rwanda defaults -->
    <record id="res_config_settings_form_view" model="ir.ui.view">
        <field name="name">res.config.settings.form.rw</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Rwanda Defaults" name="govoo_rw_defaults">
                    <setting id="govoo_rw_locale_settings"
                             string="Rwanda Locale Defaults"
                             help="Default language, timezone, and date format for new companies.">
                        <field name="govoo_default_language"/>
                        <field name="govoo_default_timezone"/>
                        <field name="govoo_default_date_format"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
