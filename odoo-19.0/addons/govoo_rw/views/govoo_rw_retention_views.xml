<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_rw_retention_search" model="ir.ui.view">
        <field name="name">govoo.rw.retention.search</field>
        <field name="model">govoo.rw.retention</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="retention_category"/>
                <field name="basis"/>
                <filter name="group_category"
                        string="By Category"
                        context="{'group_by': 'retention_category'}"/>
                <group>
                    <filter name="group_basis"
                            string="By Basis"
                            context="{'group_by': 'basis'}"/>
                    <filter name="group_company"
                            string="By Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="govoo_rw_retention_action" model="ir.actions.act_window">
        <field name="name">Retention Rules</field>
        <field name="res_model">govoo.rw.retention</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="govoo_rw_retention_search"/>
    </record>

    <record id="govoo_rw_retention_list" model="ir.ui.view">
        <field name="name">govoo.rw.retention.list</field>
        <field name="model">govoo.rw.retention</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="retention_category"/>
                <field name="basis"/>
                <field name="retention_years" invisible="basis != 'years'"/>
                <field name="retention_periods" invisible="basis != 'periods'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="govoo_rw_retention_form" model="ir.ui.view">
        <field name="name">govoo.rw.retention.form</field>
        <field name="model">govoo.rw.retention</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Retention Rule Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="retention_category"/>
                            <field name="basis"/>
                            <field name="retention_years"
                                   invisible="basis != 'years'"
                                   required="basis == 'years'"/>
                            <field name="retention_periods"
                                   invisible="basis != 'periods'"
                                   required="basis == 'periods'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>
