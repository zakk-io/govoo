<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Multi-company record rule -->
    <record id="govoo_rw_retention_comp_rule" model="ir.rule">
        <field name="name">Retention Config: multi-company</field>
        <field name="model_id" ref="model_govoo_rw_retention"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[
            (4, ref('govoo_base.group_govoo_admin')),
            (4, ref('govoo_base.group_govoo_secretary')),
        ]"/>
    </record>

</odoo>
