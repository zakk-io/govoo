<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Committee list view -->
    <record id="govoo_committee_view_list" model="ir.ui.view">
        <field name="name">govoo.committee.list</field>
        <field name="model">govoo.committee</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="chair_partner_id"/>
                <field name="parent_committee_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Committee form view -->
    <record id="govoo_committee_view_form" model="ir.ui.view">
        <field name="name">govoo.committee.form</field>
        <field name="model">govoo.committee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_members" type="object"
                                class="oe_stat_button" icon="fa-users"
                                invisible="not member_count">
                            <field name="member_count" widget="statinfo" string="Members"/>
                        </button>
                        <button name="action_view_meetings" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                invisible="not meeting_count">
                            <field name="meeting_count" widget="statinfo" string="Meetings"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="chair_partner_id"/>
                        </group>
                        <group>
                            <field name="parent_committee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members" name="members">
                            <field name="member_ids" readonly="1"/>
                        </page>
                        <page string="Terms of Reference" name="terms"
                              groups="govoo_base.group_govoo_secretary">
                            <field name="terms_of_reference_id"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Issue #251: committee had no kanban view at all. No state field on
         this model, so the colour bar is a neutral brand accent rather than
         a status indicator. -->
    <record id="govoo_committee_view_kanban" model="ir.ui.view">
        <field name="name">govoo.committee.kanban</field>
        <field name="model">govoo.committee</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="chair_partner_id"/>
                <field name="member_count"/>
                <field name="meeting_count"/>
                <templates>
                    <t t-name="card">
                        <div class="border-start border-4 border-primary ps-2">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <span class="text-muted d-block" t-if="record.chair_partner_id.value">
                                        Chaired by <field name="chair_partner_id"/>
                                    </span>
                                </div>
                                <field name="chair_partner_id" widget="many2one_avatar"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge text-bg-light me-1" t-if="record.member_count.raw_value">
                                        <i class="fa fa-users me-1"/><t t-esc="record.member_count.raw_value"/> members
                                    </span>
                                    <span class="badge text-bg-light" t-if="record.meeting_count.raw_value">
                                        <i class="fa fa-calendar me-1"/><t t-esc="record.meeting_count.raw_value"/> meetings
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="govoo_committee_view_search" model="ir.ui.view">
        <field name="name">govoo.committee.search</field>
        <field name="model">govoo.committee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="chair_partner_id"/>
                <group>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Committee action -->
    <record id="govoo_committee_action" model="ir.actions.act_window">
        <field name="name">Committees</field>
        <field name="res_model">govoo.committee</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="govoo_committee_view_search"/>
        <field name="context">{'search_default_company_id': [allowed_company_ids[0]]}</field>
    </record>

</odoo>
