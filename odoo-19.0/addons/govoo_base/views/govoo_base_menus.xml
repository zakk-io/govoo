<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Governance top-level menu -->
    <menuitem id="govoo_menu_root"
              name="Governance"
              sequence="100"
              web_icon="govoo_base,static/description/icon.png"/>

    <!-- Appointments submenu -->
    <menuitem id="govoo_menu_appointments"
              name="Appointments"
              parent="govoo_menu_root"
              sequence="10"/>

    <menuitem id="govoo_menu_appointment_list"
              name="All Appointments"
              parent="govoo_menu_appointments"
              action="govoo_appointment_action"
              sequence="10"/>

    <!-- Committees submenu -->
    <menuitem id="govoo_menu_committees"
              name="Committees"
              parent="govoo_menu_root"
              sequence="20"/>

    <menuitem id="govoo_menu_committee_list"
              name="All Committees"
              parent="govoo_menu_committees"
              action="govoo_committee_action"
              sequence="10"/>

    <!-- Configuration (Board Administrator only) -->
    <menuitem id="govoo_menu_configuration"
              name="Configuration"
              parent="govoo_menu_root"
              sequence="90"
              groups="govoo_base.group_govoo_admin"/>

    <record id="action_govoo_companies" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure company governance settings
            </p>
        </field>
    </record>

    <menuitem id="govoo_menu_configuration_companies"
              name="Companies"
              parent="govoo_menu_configuration"
              action="action_govoo_companies"
              sequence="10"/>

</odoo>
