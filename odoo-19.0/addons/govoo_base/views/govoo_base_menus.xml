<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- clagov top-level menu -->
    <menuitem id="govoo_menu_root"
              name="clagov"
              sequence="100"
              web_icon="govoo_base,static/description/icon.png"/>

    <!-- Appointments -->
    <menuitem id="govoo_menu_appointments"
              name="Appointments"
              parent="govoo_menu_root"
              action="govoo_appointment_action"
              sequence="10"/>

    <!-- Committees -->
    <menuitem id="govoo_menu_committees"
              name="Committees"
              parent="govoo_menu_root"
              action="govoo_committee_action"
              sequence="20"/>

    <!-- Configuration (Board Administrator and Company Secretary; issue
         #238 widened this from admin-only so Company Secretaries, who
         already hold read/write access on res.company, can reach the
         governance settings now added here, alongside AI Configuration
         (reparented here from govoo_ai's own top-level menu). -->
    <menuitem id="govoo_menu_configuration"
              name="Configuration"
              parent="govoo_menu_root"
              sequence="90"
              groups="govoo_base.group_govoo_admin,govoo_base.group_govoo_secretary"/>

    <record id="action_govoo_companies" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure company governance settings
            </p>
        </field>
    </record>

    <menuitem id="govoo_menu_configuration_companies"
              name="Companies"
              parent="govoo_menu_configuration"
              action="action_govoo_companies"
              sequence="10"/>

</odoo>
