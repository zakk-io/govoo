<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Appointment list view -->
    <record id="govoo_appointment_view_list" model="ir.ui.view">
        <field name="name">govoo.appointment.list</field>
        <field name="model">govoo.appointment</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'resigned'">
                <field name="partner_id"/>
                <field name="role"/>
                <field name="committee_id"/>
                <field name="date_appointed"/>
                <field name="date_resigned"/>
                <field name="end_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'resigned'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Appointment form view -->
    <record id="govoo_appointment_view_form" model="ir.ui.view">
        <field name="name">govoo.appointment.form</field>
        <field name="model">govoo.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="role"/>
                            <field name="committee_id"/>
                        </group>
                        <group>
                            <field name="date_appointed"/>
                            <field name="date_resigned"/>
                            <field name="end_date"/>
                            <field name="reminder_lead_months"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Document"
                           groups="govoo_base.group_govoo_secretary">
                        <field name="appointment_document_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Issue #251: appointment had no kanban view at all. -->
    <record id="govoo_appointment_view_kanban" model="ir.ui.view">
        <field name="name">govoo.appointment.kanban</field>
        <field name="model">govoo.appointment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="role">
                <field name="partner_id"/>
                <field name="role"/>
                <field name="committee_id"/>
                <field name="state"/>
                <field name="end_date"/>
                <templates>
                    <t t-name="card">
                        <t t-set="govoo_color" t-value="record.state.raw_value == 'active' ? 'success' : 'secondary'"/>
                        <div t-attf-class="border-start border-4 border-{{govoo_color}} ps-2 d-flex align-items-start">
                            <field name="partner_id" widget="many2one_avatar" class="me-2"/>
                            <div class="flex-grow-1">
                                <strong class="o_kanban_record_title d-block"><field name="partner_id"/></strong>
                                <span class="text-muted d-block">
                                    <field name="role"/>
                                    <t t-if="record.committee_id.value"> &#8212; <field name="committee_id"/></t>
                                </span>
                                <div t-if="record.end_date.raw_value" class="small text-muted">
                                    Ends <field name="end_date"/>
                                </div>
                            </div>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-muted="state == 'resigned'"/>
                        </div>
                    </t>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="govoo_appointment_view_search" model="ir.ui.view">
        <field name="name">govoo.appointment.search</field>
        <field name="model">govoo.appointment</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="role"/>
                <field name="committee_id"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Appointment action -->
    <record id="govoo_appointment_action" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">govoo.appointment</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="govoo_appointment_view_search"/>
        <field name="context">{'search_default_company_id': [allowed_company_ids[0]]}</field>
    </record>

</odoo>
