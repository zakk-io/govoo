<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Issue #236: sent to every active Company Secretary when an
             appointment enters its succession-planning reminder window,
             in addition to the existing internal mail.activity to-do
             (which stays assigned to create_uid as before, since this is
             the extra, actually-reaches-someone channel). -->
        <record id="mail_template_appointment_succession_reminder" model="mail.template">
            <field name="name">Appointment: Succession Planning Reminder</field>
            <field name="model_id" ref="model_govoo_appointment"/>
            <field name="subject">Succession planning: {{ object.partner_id.name }}'s appointment is ending soon</field>
            <field name="lang">{{ object.company_id.partner_id.lang }}</field>
            <field name="description">Sent to Company Secretaries when an appointment nears its End Date (issue #236)</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div>
    <p>
        Hello,<br/><br/>
        <strong t-out="object.partner_id.name or ''">Director</strong>'s appointment
        (<t t-out="object.role or ''">role</t>) is approaching its End Date
        (<t t-out="object.end_date or ''">date</t>) and may need succession planning.
    </p>
    <div style="text-align: center; padding: 16px 0px 16px 0px;">
        <a t-attf-href="/odoo/govoo.appointment/{{ object.id }}"
           style="padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px">
            View Appointment</a>
    </div>
</div>
            </field>
        </record>

    </data>
</odoo>
