<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Backend Dashboard: Govoo App Landing Page                     -->
    <!-- ============================================================ -->

    <record id="govoo_dashboard_meeting_search" model="ir.ui.view">
        <field name="name">govoo.dashboard.meeting.search</field>
        <field name="model">govoo.meeting</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_upcoming"
                        string="Upcoming (30 days)"
                        domain="[('state', 'in', ('draft', 'scheduled'))]"/>
                <group>
                    <filter name="group_committee"
                            string="By Committee"
                            context="{'group_by': 'committee_id'}"/>
                    <filter name="group_state"
                            string="By Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Dashboard action -->
    <record id="action_govoo_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">govoo.meeting</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="govoo_dashboard_meeting_search"/>
        <field name="context">{'search_default_filter_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Welcome to Govoo — Corporate Governance Platform
            </p>
            <p>
                Use the left menu to navigate between Governance, Ownership,
                Statutory Registers, Compliance, and Evaluations.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Dashboard: Compliance RAG Summary (Kanban)                    -->
    <!-- ============================================================ -->

    <record id="govoo_dashboard_compliance_search" model="ir.ui.view">
        <field name="name">govoo.dashboard.compliance.search</field>
        <field name="model">govoo.compliance.instance</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_active"
                        string="Active"
                        domain="[('state', 'in', ('upcoming', 'in_progress', 'late'))]"/>
                <filter name="filter_late"
                        string="Late"
                        domain="[('state', '=', 'late')]"/>
                <group>
                    <filter name="group_state"
                            string="By Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_obligation"
                            string="By Obligation"
                            context="{'group_by': 'obligation_id'}"/>
               </group>
            </search>
        </field>
    </record>

    <record id="action_compliance_rag_dashboard" model="ir.actions.act_window">
        <field name="name">Compliance RAG</field>
        <field name="res_model">govoo.compliance.instance</field>
        <field name="view_mode">kanban,list</field>
        <field name="search_view_id" ref="govoo_dashboard_compliance_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <record id="govoo_dashboard_compliance_kanban" model="ir.ui.view">
        <field name="name">govoo.dashboard.compliance.kanban</field>
        <field name="model">govoo.compliance.instance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    decoration-danger="state == 'late'"
                    decoration-warning="state == 'in_progress'"
                    decoration-success="state == 'upcoming'"
                    decoration-muted="state in ('filed', 'waived')">
                <field name="name"/>
                <field name="state"/>
                <field name="due_date"/>
                <field name="days_to_due"/>
                <field name="obligation_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <t t-esc="record.name.value"/>
                                    </strong>
                                </div>
                                <strong>
                                    <field name="state" widget="badge"
                                           decoration-danger="state == 'late'"
                                           decoration-warning="state == 'in_progress'"
                                           decoration-success="state == 'upcoming'"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="o_kanban_record_line">
                                    <strong>Authority:</strong>
                                    <t t-esc="record.obligation_id.raw_value.authority"/>
                                </div>
                                <div class="o_kanban_record_line" t-if="record.due_date.raw_value">
                                    <strong>Due:</strong>
                                    <t t-esc="record.due_date.value"/>
                                </div>
                                <div class="o_kanban_record_line" t-if="record.days_to_due.raw_value">
                                    <strong>Days to Due:</strong>
                                    <t t-esc="record.days_to_due.value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Dashboard: Evaluation Trend (Graph)                           -->
    <!-- ============================================================ -->

    <record id="action_evaluation_trend_dashboard" model="ir.actions.act_window">
        <field name="name">Evaluation Trends</field>
        <field name="res_model">govoo.evaluation.result</field>
        <field name="view_mode">graph,pivot</field>
    </record>

    <!-- ============================================================ -->
    <!-- Menus                                                         -->
    <!-- ============================================================ -->

    <menuitem id="govoo_menu_dashboard"
              name="Dashboard"
              parent="govoo_base.govoo_menu_root"
              sequence="5"
              action="action_govoo_dashboard"/>

    <menuitem id="govoo_menu_dashboard_compliance"
              name="Compliance RAG"
              parent="govoo_base.govoo_menu_root"
              sequence="8"
              action="action_compliance_rag_dashboard"/>

    <menuitem id="govoo_menu_dashboard_evaluation"
              name="Evaluation Trends"
              parent="govoo_base.govoo_menu_root"
              sequence="9"
              action="action_evaluation_trend_dashboard"/>

</odoo>
