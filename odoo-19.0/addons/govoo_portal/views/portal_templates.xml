<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Portal Home                                                  -->
    <!-- ============================================================ -->

    <template id="portal_home" name="Portal Home">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h3>Welcome, <t t-esc="user.name"/></h3>
                <p class="text-muted">
                    <t t-if="portal_type == 'director'">Director Portal</t>
                    <t t-elif="portal_type == 'shareholder'">Shareholder Portal</t>
                    <t t-elif="portal_type == 'procurement_committee'">Procurement Committee Portal</t>
                </p>

                <div class="row mt-4">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Quick Links</h5>
                                <ul class="list-group list-group-flush">
                                    <t t-if="portal_type == 'director'">
                                        <li class="list-group-item"><a href="/my/meetings">My Meetings</a></li>
                                        <li class="list-group-item"><a href="/my/votes">My Votes</a></li>
                                        <li class="list-group-item"><a href="/my/appointment">My Appointment</a></li>
                                    </t>
                                    <t t-if="portal_type == 'shareholder'">
                                        <li class="list-group-item"><a href="/my/holdings">My Holdings</a></li>
                                        <li class="list-group-item"><a href="/my/holdings/votes">My Votes</a></li>
                                        <li class="list-group-item"><a href="/my/register">My Register</a></li>
                                    </t>
                                    <t t-if="portal_type == 'procurement_committee'">
                                        <li class="list-group-item"><a href="/my/procurement/tenders">My Tender Evaluations</a></li>
                                        <li class="list-group-item"><a href="/my/meetings">My Meetings</a></li>
                                    </t>
                                    <t t-if="portal_type == 'internal'">
                                        <li class="list-group-item"><a href="/web">Back to Odoo</a></li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Director Portal: My Meetings                                  -->
    <!-- ============================================================ -->

    <template id="portal_my_meetings" name="My Meetings">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar"/>

            <t t-if="not meetings">
                <p class="text-muted">No meetings found.</p>
            </t>

            <t t-foreach="meetings" t-as="meeting">
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">
                            <a t-attf-href="/my/meetings/#{meeting.id}?access_token=#{meeting._portal_ensure_token()}"
                               t-esc="meeting.name"/>
                        </h5>
                        <p class="card-text text-muted mb-1">
                            <strong>Committee:</strong> <t t-esc="meeting.committee_id.name"/>
                        </p>
                        <p class="card-text text-muted mb-1" t-if="meeting.date">
                            <strong>Date:</strong> <t t-esc="meeting.date"
                                                      t-options="{'widget': 'datetime'}"/>
                        </p>
                        <span class="badge"
                              t-attf-class="badge #{meeting.state == 'draft' and 'bg-secondary' or meeting.state == 'scheduled' and 'bg-primary' or meeting.state == 'held' and 'bg-success' or 'bg-info'}"
                              t-esc="meeting.state"/>
                    </div>
                </div>
            </t>

            <t t-call="portal.pager"/>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Director Portal: Meeting Detail                               -->
    <!-- ============================================================ -->

    <template id="portal_my_meeting" name="Meeting Detail">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-body">
                    <h3 t-esc="meeting.name"/>

                    <table class="table table-sm">
                        <tr>
                            <td><strong>Committee:</strong></td>
                            <td><t t-esc="meeting.committee_id.name"/></td>
                        </tr>
                        <tr t-if="meeting.date">
                            <td><strong>Date:</strong></td>
                            <td><t t-esc="meeting.date"
                                   t-options="{'widget': 'datetime'}"/></td>
                        </tr>
                        <tr>
                            <td><strong>Status:</strong></td>
                            <td><t t-esc="meeting.state"/></td>
                        </tr>
                        <tr t-if="meeting.location">
                            <td><strong>Location:</strong></td>
                            <td><t t-esc="meeting.location"/></td>
                        </tr>
                    </table>

                    <h4 class="mt-4">Agenda</h4>
                    <t t-if="meeting.agenda_ids">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Item</th>
                                    <th>Confidential</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="meeting.agenda_ids" t-as="item">
                                    <tr>
                                        <td><t t-esc="item.sequence"/></td>
                                        <td>
                                            <t t-if="item.is_confidential">
                                                <em class="text-muted">[Confidential — see board pack]</em>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="item.title"/>
                                            </t>
                                        </td>
                                        <td>
                                            <t t-if="item.is_confidential">
                                                <span class="badge bg-warning">Confidential</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <p class="text-muted">No agenda items.</p>
                    </t>

                    <div class="mt-4" t-if="meeting.pack_id">
                        <h4>Board Pack</h4>
                        <p>Status: <t t-esc="meeting.pack_id.state"/></p>
                        <t t-if="pack_recipient">
                            <p class="text-success">
                                Sent to you<t t-if="pack_recipient.sent_date">
                                    on <t t-esc="pack_recipient.sent_date" t-options="{'widget': 'datetime'}"/></t>.
                                <t t-if="pack_recipient.redacted_item_ids">
                                    Some confidential agenda items were excluded from your copy.
                                </t>
                            </p>
                            <a t-if="meeting.pack_id.document_id"
                               t-attf-href="/my/meetings/#{meeting.id}/pack?access_token=#{token}"
                               class="btn btn-primary">
                                <i class="fa fa-download me-1"/> Download Board Pack
                            </a>
                        </t>
                        <t t-else="">
                            <p class="text-muted">Not yet distributed to you.</p>
                        </t>
                    </div>

                    <div class="mt-4" t-if="meeting.state in ('held', 'minuted', 'closed')">
                        <h4>Minutes</h4>
                        <t t-if="meeting.minutes_id">
                            <p>Minutes status: <t t-esc="meeting.minutes_id.state"/></p>
                        </t>
                        <t t-else="">
                            <p class="text-muted">Minutes not yet available.</p>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Procurement Committee Portal: My Tender Evaluations           -->
    <!-- ============================================================ -->

    <template id="portal_my_procurement_tenders" name="My Tender Evaluations">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar"/>

            <t t-if="not tenders">
                <p class="text-muted">No tenders found.</p>
            </t>

            <t t-foreach="tenders" t-as="tender">
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">
                            <a t-attf-href="/my/procurement/tenders/#{tender.id}" t-esc="tender.name"/>
                        </h5>
                        <p class="card-text text-muted mb-1" t-if="tender.tender_category_id">
                            <strong>Category:</strong> <t t-esc="tender.tender_category_id.name"/>
                        </p>
                        <span class="badge bg-info" t-esc="dict(tender._fields['evaluation_stage'].selection).get(tender.evaluation_stage)"/>
                    </div>
                </div>
            </t>

            <t t-call="portal.pager"/>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Procurement Committee Portal: Tender Detail (read-only)       -->
    <!-- ============================================================ -->

    <template id="portal_my_procurement_tender" name="Tender Evaluation Detail">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-body">
                    <h3 t-esc="tender.name"/>

                    <table class="table table-sm">
                        <tr t-if="tender.tender_category_id">
                            <td><strong>Category:</strong></td>
                            <td><t t-esc="tender.tender_category_id.name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Evaluation Stage:</strong></td>
                            <td><t t-esc="dict(tender._fields['evaluation_stage'].selection).get(tender.evaluation_stage)"/></td>
                        </tr>
                        <tr t-if="tender.submission_deadline">
                            <td><strong>Submission Deadline:</strong></td>
                            <td><t t-esc="tender.submission_deadline"/></td>
                        </tr>
                        <tr t-if="tender.evaluation_meeting_id">
                            <td><strong>Evaluation Meeting:</strong></td>
                            <td>
                                <a t-attf-href="/my/meetings/#{tender.evaluation_meeting_id.id}">
                                    <t t-esc="tender.evaluation_meeting_id.name"/> (<t t-esc="tender.evaluation_meeting_id.date"/>)
                                </a>
                            </td>
                        </tr>
                    </table>

                    <h4 class="mt-4">Vendor Bids</h4>
                    <t t-if="tender.bid_ids">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Vendor</th>
                                    <th>Technical Score</th>
                                    <th>Financial Score</th>
                                    <th>Documents</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="tender.bid_ids" t-as="bid">
                                    <tr>
                                        <td><t t-esc="bid.name"/></td>
                                        <td><t t-esc="bid.partner_id.name"/></td>
                                        <td><t t-esc="bid.govoo_technical_score"/></td>
                                        <td><t t-esc="bid.govoo_financial_score"/></td>
                                        <td>
                                            <t t-if="not bid.document_ids">
                                                <span class="text-muted">—</span>
                                            </t>
                                            <t t-foreach="bid.document_ids" t-as="bid_doc">
                                                <a t-attf-href="/web/content/#{bid_doc.id}?download=true"
                                                   class="d-block" t-esc="bid_doc.name"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <p class="text-muted">No vendor bids yet.</p>
                    </t>

                    <div class="mt-4" t-if="tender.document_ids">
                        <h4>Tender Documents</h4>
                        <ul class="list-group list-group-flush">
                            <t t-foreach="tender.document_ids" t-as="doc">
                                <li class="list-group-item">
                                    <a t-attf-href="/web/content/#{doc.id}?download=true" t-esc="doc.name"/>
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Director Portal: My Votes                                     -->
    <!-- ============================================================ -->

    <template id="portal_my_votes" name="My Votes">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar"/>

            <!-- Issue #269 item 1: resolutions the current user can cast
                 as a registered proxy for someone else. -->
            <t t-if="proxy_items">
                <h5 class="mt-2 mb-3">Votes You Can Cast as Proxy</h5>
                <t t-foreach="proxy_items" t-as="proxy_item">
                    <div class="card mb-3 border-info">
                        <div class="card-body">
                            <span class="badge text-bg-info mb-2">Proxy for <t t-esc="proxy_item['principal'].name"/></span>
                            <h5 class="card-title">
                                <t t-esc="proxy_item['resolution'].title"/>
                            </h5>
                            <a t-attf-href="/my/votes/#{proxy_item['resolution'].id}/cast?access_token=#{proxy_item['resolution']._portal_ensure_token()}&amp;on_behalf_of=#{proxy_item['principal'].id}"
                               class="btn btn-info btn-sm mt-2">
                                Cast Vote as Proxy
                            </a>
                        </div>
                    </div>
                </t>
                <hr class="my-4"/>
            </t>

            <t t-if="not resolutions">
                <p class="text-muted">No resolutions requiring your vote.</p>
            </t>

            <t t-foreach="resolutions" t-as="resolution">
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">
                            <a t-esc="resolution.title"/>
                        </h5>
                        <p class="card-text text-muted mb-1">
                            <strong>Type:</strong> <t t-esc="resolution.resolution_type"/>
                        </p>
                        <p class="card-text text-muted mb-1" t-if="resolution.meeting_id.committee_id">
                            <strong>Committee:</strong> <t t-esc="resolution.meeting_id.committee_id.name"/>
                        </p>
                        <a t-attf-href="/my/votes/#{resolution.id}/cast?access_token=#{resolution._portal_ensure_token()}"
                           class="btn btn-primary btn-sm mt-2">
                            Cast Vote
                        </a>
                    </div>
                </div>
            </t>

            <t t-call="portal.pager"/>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Director Portal: Cast Vote                                    -->
    <!-- ============================================================ -->

    <template id="portal_cast_vote" name="Cast Vote">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-body">
                    <h3>Vote on: <t t-esc="resolution.title"/></h3>

                    <t t-if="on_behalf_of">
                        <div class="alert alert-info">
                            You are casting this vote as proxy for <strong t-esc="principal_name"/>.
                        </div>
                    </t>

                    <!-- Issue #269 item 2: disclose the actual vote weight
                         before any choice is submitted. -->
                    <p class="text-muted">
                        Your vote weight: <strong t-esc="weight"/>
                    </p>

                    <t t-if="error">
                        <div class="alert alert-danger" t-esc="error"/>
                    </t>

                    <t t-if="confirm_step">
                        <div class="alert alert-warning">
                            Confirm your vote: <strong t-esc="selected_choice"/>. This cannot be changed once submitted.
                        </div>
                        <form t-attf-action="/my/votes/#{resolution.id}/cast" method="POST">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="vote_choice" t-att-value="selected_choice"/>
                            <input type="hidden" name="conflict_declared" t-att-value="'1' if selected_conflict else ''"/>
                            <input type="hidden" name="confirmed" value="1"/>
                            <input type="hidden" name="on_behalf_of" t-att-value="on_behalf_of" t-if="on_behalf_of"/>
                            <button type="submit" class="btn btn-primary">Confirm &amp; Submit Vote</button>
                            <a t-attf-href="/my/votes/#{resolution.id}/cast?access_token=#{token or ''}" class="btn btn-secondary ms-2">Change Choice</a>
                        </form>
                    </t>
                    <t t-else="">
                        <form t-attf-action="/my/votes/#{resolution.id}/cast" method="POST">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="on_behalf_of" t-att-value="on_behalf_of" t-if="on_behalf_of"/>

                            <div class="mb-3">
                                <label class="form-label"><strong>Your Vote:</strong></label>
                                <div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio"
                                               name="vote_choice" value="for" id="vote_for"/>
                                        <label class="form-check-label" for="vote_for">For</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio"
                                               name="vote_choice" value="against" id="vote_against"/>
                                        <label class="form-check-label" for="vote_against">Against</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio"
                                               name="vote_choice" value="abstain" id="vote_abstain"/>
                                        <label class="form-check-label" for="vote_abstain">Abstain</label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="conflict_declared" value="1" id="conflict"/>
                                    <label class="form-check-label" for="conflict">
                                        I declare a conflict of interest on this matter
                                    </label>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">Continue</button>
                            <a href="/my/votes" class="btn btn-secondary ms-2">Cancel</a>
                        </form>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Director Portal: My Appointment                               -->
    <!-- ============================================================ -->

    <template id="portal_my_appointment" name="My Appointment">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-body">
                    <h3>My Appointment</h3>
                    <t t-if="appointment">
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Committee:</strong></td>
                                <td><t t-esc="appointment.committee_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Role:</strong></td>
                                <td><t t-esc="appointment.role"/></td>
                            </tr>
                            <tr>
                                <td><strong>Date Appointed:</strong></td>
                                <td><t t-esc="appointment.date_appointed"
                                       t-options="{'widget': 'date'}"/></td>
                            </tr>
                            <tr t-if="appointment.date_resigned">
                                <td><strong>Date Resigned:</strong></td>
                                <td><t t-esc="appointment.date_resigned"
                                       t-options="{'widget': 'date'}"/></td>
                            </tr>
                            <tr>
                                <td><strong>Status:</strong></td>
                                <td><t t-esc="appointment.state"/></td>
                            </tr>
                        </table>
                    </t>
                    <t t-else="">
                        <p class="text-muted">No active appointment found.</p>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Shareholder Portal: My Holdings                                -->
    <!-- ============================================================ -->

    <template id="portal_my_holdings" name="My Holdings">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar"/>

            <t t-if="not holdings">
                <p class="text-muted">No holdings found.</p>
            </t>

            <t t-else="">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Share Class</th>
                            <th>Quantity</th>
                            <th>Percentage</th>
                            <th>Voting Power</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="holdings" t-as="holding">
                            <tr>
                                <td><t t-esc="holding.share_class_id.name"/></td>
                                <td><t t-esc="holding.quantity"/></td>
                                <td><t t-esc="holding.percentage"/>%</td>
                                <td><t t-esc="holding.voting_power"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

            <t t-call="portal.pager"/>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Shareholder Portal: My Shareholder Votes                      -->
    <!-- ============================================================ -->

    <template id="portal_my_shareholder_votes" name="My Shareholder Votes">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar"/>

            <!-- Issue #269 item 1: resolutions the current user can cast
                 as a registered proxy for someone else. -->
            <t t-if="proxy_items">
                <h5 class="mt-2 mb-3">Votes You Can Cast as Proxy</h5>
                <t t-foreach="proxy_items" t-as="proxy_item">
                    <div class="card mb-3 border-info">
                        <div class="card-body">
                            <span class="badge text-bg-info mb-2">Proxy for <t t-esc="proxy_item['principal'].name"/></span>
                            <h5 class="card-title">
                                <t t-esc="proxy_item['resolution'].title"/>
                            </h5>
                            <a t-attf-href="/my/holdings/votes/#{proxy_item['resolution'].id}/cast?access_token=#{proxy_item['resolution']._portal_ensure_token()}&amp;on_behalf_of=#{proxy_item['principal'].id}"
                               class="btn btn-info btn-sm mt-2">
                                Cast Vote as Proxy
                            </a>
                        </div>
                    </div>
                </t>
                <hr class="my-4"/>
            </t>

            <t t-if="not resolutions">
                <p class="text-muted">No shareholder resolutions requiring your vote.</p>
            </t>

            <t t-foreach="resolutions" t-as="resolution">
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">
                            <t t-esc="resolution.title"/>
                        </h5>
                        <p class="card-text text-muted mb-1">
                            <strong>Type:</strong> <t t-esc="resolution.resolution_type"/>
                        </p>
                        <a t-attf-href="/my/holdings/votes/#{resolution.id}/cast?access_token=#{resolution._portal_ensure_token()}"
                           class="btn btn-primary btn-sm mt-2">
                            Cast Vote
                        </a>
                    </div>
                </div>
            </t>

            <t t-call="portal.pager"/>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Shareholder Portal: Cast Vote                                 -->
    <!-- ============================================================ -->

    <template id="portal_cast_vote_shareholder" name="Cast Vote (Shareholder)">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-body">
                    <h3>Vote on: <t t-esc="resolution.title"/></h3>

                    <t t-if="on_behalf_of">
                        <div class="alert alert-info">
                            You are casting this vote as proxy for <strong t-esc="principal_name"/>.
                        </div>
                    </t>

                    <!-- Issue #269 item 2: disclose the actual vote weight
                         (voting power) before any choice is submitted. -->
                    <p class="text-muted">
                        Your vote weight: <strong t-esc="weight"/>
                    </p>

                    <t t-if="error">
                        <div class="alert alert-danger" t-esc="error"/>
                    </t>

                    <t t-if="confirm_step">
                        <div class="alert alert-warning">
                            Confirm your vote: <strong t-esc="selected_choice"/>. This cannot be changed once submitted.
                        </div>
                        <form t-attf-action="/my/holdings/votes/#{resolution.id}/cast" method="POST">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="vote_choice" t-att-value="selected_choice"/>
                            <input type="hidden" name="conflict_declared" t-att-value="'1' if selected_conflict else ''"/>
                            <input type="hidden" name="confirmed" value="1"/>
                            <input type="hidden" name="on_behalf_of" t-att-value="on_behalf_of" t-if="on_behalf_of"/>
                            <button type="submit" class="btn btn-primary">Confirm &amp; Submit Vote</button>
                            <a t-attf-href="/my/holdings/votes/#{resolution.id}/cast?access_token=#{token or ''}" class="btn btn-secondary ms-2">Change Choice</a>
                        </form>
                    </t>
                    <t t-else="">
                        <form t-attf-action="/my/holdings/votes/#{resolution.id}/cast" method="POST">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="on_behalf_of" t-att-value="on_behalf_of" t-if="on_behalf_of"/>

                            <div class="mb-3">
                                <label class="form-label"><strong>Your Vote:</strong></label>
                                <div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio"
                                               name="vote_choice" value="for" id="vote_for_sh"/>
                                        <label class="form-check-label" for="vote_for_sh">For</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio"
                                               name="vote_choice" value="against" id="vote_against_sh"/>
                                        <label class="form-check-label" for="vote_against_sh">Against</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio"
                                               name="vote_choice" value="abstain" id="vote_abstain_sh"/>
                                        <label class="form-check-label" for="vote_abstain_sh">Abstain</label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="conflict_declared" value="1" id="conflict_sh"/>
                                    <label class="form-check-label" for="conflict_sh">
                                        I declare a conflict of interest on this matter
                                    </label>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">Continue</button>
                            <a href="/my/holdings/votes" class="btn btn-secondary ms-2">Cancel</a>
                        </form>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Shareholder Portal: My Register Entry                         -->
    <!-- ============================================================ -->

    <template id="portal_my_register" name="My Register Entry">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-body">
                    <h3>Register of Members — My Entry</h3>
                    <t t-if="register_entry">
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Name:</strong></td>
                                <td><t t-esc="register_entry.partner_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Date Entered:</strong></td>
                                <td><t t-esc="register_entry.date_entered"
                                       t-options="{'widget': 'date'}"/></td>
                            </tr>
                            <tr t-if="register_entry.date_ceased">
                                <td><strong>Date Ceased:</strong></td>
                                <td><t t-esc="register_entry.date_ceased"
                                       t-options="{'widget': 'date'}"/></td>
                            </tr>
                        </table>
                    </t>
                    <t t-else="">
                        <p class="text-muted">No register entry found.</p>
                    </t>
                </div>
            </div>
        </t>
    </template>

</odoo>
