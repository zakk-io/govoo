<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Issue #333 follow-up: a Procurement Committee portal member
             needs to see their own tender's evaluation meeting and its
             minutes, not just the tender/bid records themselves; same
             committee-membership scoping already used for the Director
             Portal's own meeting/minutes rules in
             govoo_board/security/govoo_board_security.xml, just extended
             to the new group. Lives here (not in govoo_board or
             govoo_procurement) because this is the only module that
             depends on both the group (govoo_procurement) and the models
             (govoo_board); govoo_procurement depends on govoo_board, not
             the other way round, so neither of those modules alone can
             reference both. -->
        <record id="govoo_meeting_procurement_committee_portal_rule" model="ir.rule">
            <field name="name">Meeting: Procurement Committee Portal scope</field>
            <field name="model_id" ref="govoo_board.model_govoo_meeting"/>
            <field name="domain_force">[('committee_id.member_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('govoo_procurement.group_govoo_procurement_committee_portal'))]"/>
        </record>

        <record id="govoo_minutes_procurement_committee_portal_rule" model="ir.rule">
            <field name="name">Minutes: Procurement Committee Portal scope</field>
            <field name="model_id" ref="govoo_board.model_govoo_minutes"/>
            <field name="domain_force">[('meeting_id.committee_id.member_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('govoo_procurement.group_govoo_procurement_committee_portal'))]"/>
        </record>

        <!-- Issue #342: a committee member who evaluated a tender should
             be able to see the contract that resulted from the award
             they voted on; reuses govoo_contracts's own already-built
             Contract Viewer Portal (ContractPortal, /my/contracts/<id>)
             rather than a new route/template, so this rule is the only
             piece that's actually new. Lives here for the same reason
             as the two rules above: govoo_contracts depends on
             govoo_procurement (not the other way round), so neither
             module alone can reference both the group and
             govoo.contract. Scoped via tender_id (govoo_contracts'
             own #304 link) then an OR across both evaluation meetings,
             same shape already used for govoo_tender_committee_portal_rule/
             purchase_order_committee_portal_rule in
             govoo_procurement_security.xml since #337 split evaluation
             into two meetings; in scope via either one, not just the
             first. -->
        <record id="govoo_contract_committee_portal_rule" model="ir.rule">
            <field name="name">Contract: Procurement Committee Portal scope</field>
            <field name="model_id" ref="govoo_contracts.model_govoo_contract"/>
            <field name="domain_force">['|', ('tender_id.technical_evaluation_meeting_id.committee_id.member_ids.partner_id', '=', user.partner_id.id), ('tender_id.financial_evaluation_meeting_id.committee_id.member_ids.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('govoo_procurement.group_govoo_procurement_committee_portal'))]"/>
        </record>
    </data>
</odoo>
