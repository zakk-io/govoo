<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_contract_view_list" model="ir.ui.view">
        <field name="name">govoo.contract.list</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="contract_type_id"/>
                <field name="counterparty_id"/>
                <field name="value"/>
                <field name="date_end"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('executed', 'active')"
                       decoration-info="state == 'approved'"
                       decoration-warning="state in ('draft', 'in_approval')"
                       decoration-muted="state in ('expired', 'terminated')"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_contract_view_form" model="ir.ui.view">
        <field name="name">govoo.contract.form</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit for Approval"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'in_approval'"
                            groups="govoo_base.group_govoo_contract_approver"/>
                    <button name="action_execute" string="Execute"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'executed'"/>
                    <button name="action_expire" string="Mark Expired"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_terminate" string="Terminate"
                            type="object"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_approval,approved,executed,active"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="contract_type_id"/>
                            <field name="counterparty_id"/>
                            <field name="portal_approver_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="value"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="renewal_type"/>
                            <field name="resolution_id"/>
                            <field name="sign_request_id"/>
                            <field name="executed_document_id" readonly="state in ('executed', 'active', 'expired', 'terminated')"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="govoo_contract_view_kanban" model="ir.ui.view">
        <field name="name">govoo.contract.kanban</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="state"/>
                <field name="counterparty_id"/>
                <field name="date_end"/>
                <templates>
                    <t t-name="card">
                        <field name="name"/>
                        <field name="counterparty_id"/>
                        <field name="date_end"/>
                        <field name="state" widget="badge"
                               decoration-success="state in ('executed', 'active')"
                               decoration-warning="state in ('draft', 'in_approval')"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="govoo_contract_view_calendar" model="ir.ui.view">
        <field name="name">govoo.contract.calendar</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <calendar date_start="date_end" string="Contract Expiry/Renewal" event_open_popup="1">
                <field name="name"/>
                <field name="counterparty_id"/>
            </calendar>
        </field>
    </record>

    <record id="govoo_contract_view_search" model="ir.ui.view">
        <field name="name">govoo.contract.search</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="counterparty_id"/>
                <field name="contract_type_id"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_in_approval" string="In Approval" domain="[('state', '=', 'in_approval')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Contract Type" context="{'group_by': 'contract_type_id'}"/>
                    <filter name="group_counterparty" string="Counterparty" context="{'group_by': 'counterparty_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="govoo_contract_action" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">govoo.contract</field>
        <field name="view_mode">list,form,kanban,calendar</field>
    </record>

</odoo>
