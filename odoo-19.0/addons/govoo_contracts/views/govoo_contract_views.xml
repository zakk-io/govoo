<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_contract_view_list" model="ir.ui.view">
        <field name="name">govoo.contract.list</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ('executed', 'active')"
                  decoration-info="state == 'approved'"
                  decoration-warning="state in ('draft', 'in_approval')"
                  decoration-muted="state in ('expired', 'terminated')"
                  default_group_by="state">
                <field name="name"/>
                <field name="contract_type_id"/>
                <field name="counterparty_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="value" widget="monetary"/>
                <field name="date_end"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('executed', 'active')"
                       decoration-info="state == 'approved'"
                       decoration-warning="state in ('draft', 'in_approval')"
                       decoration-muted="state in ('expired', 'terminated')"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_contract_view_form" model="ir.ui.view">
        <field name="name">govoo.contract.form</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit for Approval"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'in_approval'"
                            groups="govoo_base.group_govoo_contract_approver"/>
                    <button name="action_execute" string="Execute"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'executed'"/>
                    <button name="action_expire" string="Mark Expired"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_terminate" string="Terminate"
                            type="object"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_approval,approved,executed,active"/>
                </header>
                <sheet>
                    <!-- Issue #253: ribbon for both terminal outcomes. Stock
                         Odoo 19 ships a native web_ribbon widget (web/static/
                         src/views/widgets/ribbon/), already used by
                         govoo_secretarial's beneficial-owner form, so this
                         uses that instead of the custom .o_ribbon class #251
                         built under the mistaken belief no ribbon mechanism
                         was available. -->
                    <widget name="web_ribbon" title="Expired" bg_color="bg-dark"
                            invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Terminated" bg_color="bg-secondary"
                            invisible="state != 'terminated'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_obligations" type="object"
                                class="oe_stat_button" icon="fa-tasks"
                                invisible="not obligation_count">
                            <field name="obligation_count" widget="statinfo" string="Obligations"/>
                        </button>
                        <button name="action_view_milestones" type="object"
                                class="oe_stat_button" icon="fa-flag-checkered"
                                invisible="not milestone_count">
                            <field name="milestone_count" widget="statinfo" string="Milestones"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="contract_type_id"/>
                            <field name="counterparty_id"/>
                            <field name="is_related_party" readonly="1"
                                   help="Whether the counterparty is a director, shareholder, or other related party. When set, this contract needs a declared conflict of interest before it can be approved."/>
                            <field name="conflict_declared" invisible="not is_related_party"
                                   help="Confirms the related-party conflict of interest on this contract has been formally declared, as required before approval."/>
                            <field name="conflict_declaration_notes" invisible="not is_related_party"/>
                            <field name="portal_approver_ids" widget="many2many_tags"
                                   help="People outside the counterparty who should also see this contract as a named approver in the portal."/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="value"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="renewal_type"/>
                            <field name="renewal_date" invisible="renewal_type != 'auto'"
                                   help="The date this contract is due to renew, distinct from End Date (when the current term expires)."/>
                            <field name="retention_until" readonly="1"
                                   help="Statutory or company-policy date this contract must be kept on file until, computed from its contract type's retention period."/>
                            <field name="termination_reason" invisible="state not in ('active', 'terminated')"
                                   help="Required before this contract can be marked Terminated. Whether termination was for breach or by mutual agreement can affect liability, so record the reason precisely."/>
                            <field name="resolution_id"
                                   help="Required, and must have Passed, before this contract can be approved if its type requires board approval or its value meets the type's approval threshold."/>
                            <field name="sign_request_id"/>
                            <field name="sign_status" widget="badge"
                                   decoration-success="sign_status == 'signed'"
                                   decoration-info="sign_status == 'sent'"
                                   decoration-danger="sign_status == 'declined'"
                                   decoration-muted="sign_status in ('not_sent', 'cancelled')"
                                   invisible="not sign_request_id"
                                   help="Tracks the e-signature lifecycle of the signing document, independent of the contract's own Status above."/>
                            <div class="d-flex gap-2" invisible="not sign_request_id">
                                <button name="action_send_for_signature" string="Send for Signature"
                                        type="object" class="btn-secondary"
                                        invisible="sign_status not in ('not_sent', 'declined', 'cancelled')"/>
                                <button name="action_mark_signed" string="Mark Signed"
                                        type="object" class="btn-secondary"
                                        invisible="sign_status != 'sent'"/>
                                <button name="action_mark_declined" string="Mark Declined"
                                        type="object" class="btn-secondary"
                                        invisible="sign_status != 'sent'"/>
                                <button name="action_cancel_signature" string="Cancel"
                                        type="object" class="btn-secondary"
                                        invisible="sign_status != 'sent'"/>
                            </div>
                            <field name="executed_document_id"
                                   readonly="executed_document_id and state in ('executed', 'active', 'expired', 'terminated')"
                                   help="Locked once the contract is Executed — an amendment or renewal must attach a new document rather than replace this one."/>
                            <field name="executed_document_upload" filename="executed_document_upload_filename"
                                   readonly="executed_document_id and state in ('executed', 'active', 'expired', 'terminated')"/>
                            <field name="executed_document_upload_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Clauses">
                        <field name="template_id" readonly="1"/>
                        <field name="clause_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Obligations" name="obligations">
                            <field name="obligation_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="responsible_id"/>
                                    <field name="amount"/>
                                    <field name="lead_time_days"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Milestones" name="milestones">
                            <field name="milestone_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="value"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="govoo_contract_view_kanban" model="ir.ui.view">
        <field name="name">govoo.contract.kanban</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <!-- Issue #251: colour bar, monetary value, due-date chip (red
                 when already past or within the obligation list's own 60-
                 day "expiring soon" window — same threshold used by the
                 #252/#261 KPI tiles), obligation-count badge, quick-action
                 menu. -->
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="state"/>
                <field name="counterparty_id"/>
                <field name="currency_id"/>
                <field name="value"/>
                <field name="date_end"/>
                <field name="obligation_count"/>
                <templates>
                    <t t-name="card">
                        <t t-set="govoo_color" t-value="['executed', 'active'].includes(record.state.raw_value) ? 'success' : (record.state.raw_value == 'approved' ? 'info' : (['draft', 'in_approval'].includes(record.state.raw_value) ? 'warning' : 'secondary'))"/>
                        <div t-attf-class="border-start border-4 border-{{govoo_color}} ps-2">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <span class="text-muted d-block"><field name="counterparty_id"/></span>
                                </div>
                                <field name="state" widget="badge"
                                       decoration-success="state in ('executed', 'active')"
                                       decoration-info="state == 'approved'"
                                       decoration-warning="state in ('draft', 'in_approval')"
                                       decoration-muted="state in ('expired', 'terminated')"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="value" widget="monetary"/>
                                <div t-if="record.date_end.raw_value">
                                    Ends <field name="date_end"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge text-bg-light" t-if="record.obligation_count.raw_value">
                                        <i class="fa fa-tasks me-1"/><t t-esc="record.obligation_count.raw_value"/> obligations
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="govoo_contract_view_calendar" model="ir.ui.view">
        <field name="name">govoo.contract.calendar</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <calendar date_start="date_end" string="Contract Expiry/Renewal"
                      event_open_popup="1" color="renewal_type">
                <field name="name"/>
                <field name="counterparty_id"/>
                <field name="renewal_type" filters="1"/>
            </calendar>
        </field>
    </record>

    <record id="govoo_contract_view_pivot" model="ir.ui.view">
        <field name="name">govoo.contract.pivot</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <pivot string="Spend by Counterparty">
                <field name="counterparty_id" type="row"/>
                <field name="contract_type_id" type="col"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="govoo_contract_view_graph" model="ir.ui.view">
        <field name="name">govoo.contract.graph</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <graph string="Spend by Counterparty" type="bar">
                <field name="counterparty_id"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="govoo_contract_view_search" model="ir.ui.view">
        <field name="name">govoo.contract.search</field>
        <field name="model">govoo.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="counterparty_id"/>
                <field name="contract_type_id"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_in_approval" string="In Approval" domain="[('state', '=', 'in_approval')]"/>
                <!-- Issue #253: same 60-day window and state as the
                     "Expiring in 60 Days" KPI tile
                     (govoo_portal/static/src/kpi_strip/list_kpi/list_kpi_views.js)
                     — kept identical so the filter and the tile always agree. -->
                <filter name="filter_expiring_soon" string="Expiring Soon (60d)"
                        domain="[('state', '=', 'active'),
                                 ('date_end', '!=', False),
                                 ('date_end', '&lt;=', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_end_date" string="End Date"
                        date="date_end" default_period="month"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Contract Type" context="{'group_by': 'contract_type_id'}"/>
                    <filter name="group_counterparty" string="Counterparty" context="{'group_by': 'counterparty_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="govoo_contract_action" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">govoo.contract</field>
        <field name="view_mode">list,form,kanban,calendar,pivot,graph</field>
    </record>

</odoo>
