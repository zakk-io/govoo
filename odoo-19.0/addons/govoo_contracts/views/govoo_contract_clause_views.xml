<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_contract_clause_view_list" model="ir.ui.view">
        <field name="name">govoo.contract.clause.list</field>
        <field name="model">govoo.contract.clause</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="clause_category"/>
                <field name="is_mandatory"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_contract_clause_view_form" model="ir.ui.view">
        <field name="name">govoo.contract.clause.form</field>
        <field name="model">govoo.contract.clause</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="clause_category"/>
                        <field name="is_mandatory"/>
                        <field name="active"/>
                    </group>
                    <group string="Clause Text">
                        <field name="body" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="govoo_contract_clause_view_search" model="ir.ui.view">
        <field name="name">govoo.contract.clause.search</field>
        <field name="model">govoo.contract.clause</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_mandatory" string="Mandatory" domain="[('is_mandatory', '=', True)]"/>
                <filter name="filter_optional" string="Optional" domain="[('is_mandatory', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="govoo_contract_clause_action" model="ir.actions.act_window">
        <field name="name">Clauses</field>
        <field name="res_model">govoo.contract.clause</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
