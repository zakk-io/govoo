<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_contract_type_view_list" model="ir.ui.view">
        <field name="name">govoo.contract.type.list</field>
        <field name="model">govoo.contract.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="requires_board_approval"/>
                <field name="approval_threshold"/>
                <field name="retention_years"/>
                <field name="e_signature_enabled"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_contract_type_view_form" model="ir.ui.view">
        <field name="name">govoo.contract.type.form</field>
        <field name="model">govoo.contract.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="requires_board_approval"
                                   help="Contracts of this type cannot be approved without a linked board resolution that has passed."/>
                            <field name="approval_threshold"
                                   help="A contract of this type at or above this value also requires board approval, even if the toggle above is off."/>
                            <field name="retention_years"
                                   help="Statutory or company-policy minimum period to keep contracts of this type on file after they end."/>
                            <field name="renewal_notice_days"
                                   help="How many days before the contract's End Date to send a renewal/expiry reminder. 0 disables the reminder."/>
                            <field name="e_signature_enabled"
                                   help="Allows e-signature for contracts of this type. Leave off if this type of contract must be signed through a different legally required channel, such as a government procurement portal."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="govoo_contract_type_action" model="ir.actions.act_window">
        <field name="name">Contract Types</field>
        <field name="res_model">govoo.contract.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
