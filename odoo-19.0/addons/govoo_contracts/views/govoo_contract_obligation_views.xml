<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_contract_obligation_view_list" model="ir.ui.view">
        <field name="name">govoo.contract.obligation.list</field>
        <field name="model">govoo.contract.obligation</field>
        <field name="arch" type="xml">
            <list decoration-danger="rag_color == 'red'"
                  decoration-warning="rag_color == 'amber'"
                  decoration-success="rag_color == 'green'"
                  decoration-muted="rag_color == 'grey'"
                  default_order="days_to_due">
                <field name="contract_id"/>
                <field name="name"/>
                <field name="due_date"/>
                <field name="days_to_due"/>
                <field name="responsible_id"/>
                <field name="amount"/>
                <field name="rag_color" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('done', 'waived')"
                       decoration-warning="state == 'open'"
                       decoration-danger="state == 'overdue'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_contract_obligation_view_form" model="ir.ui.view">
        <field name="name">govoo.contract.obligation.form</field>
        <field name="model">govoo.contract.obligation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" string="Mark Done"
                            type="object" class="oe_highlight"
                            invisible="state in ('done', 'waived')"/>
                    <button name="action_waive" string="Waive"
                            type="object"
                            invisible="state in ('done', 'waived')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="name"/>
                            <field name="due_date"/>
                            <field name="days_to_due"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="amount"/>
                            <field name="lead_time_days"/>
                            <field name="rag_color" widget="badge"
                                   decoration-success="rag_color == 'green'"
                                   decoration-warning="rag_color == 'amber'"
                                   decoration-danger="rag_color == 'red'"
                                   decoration-muted="rag_color == 'grey'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="govoo_contract_obligation_view_kanban" model="ir.ui.view">
        <field name="name">govoo.contract.obligation.kanban</field>
        <field name="model">govoo.contract.obligation</field>
        <field name="arch" type="xml">
            <!-- Issue #251: colour bar, single rag_color badge, due-date
                 text, responsible-user avatar, and a "time elapsed toward
                 due" progress bar computed from the two fields the model
                 already stores (lead_time_days, days_to_due) — no new
                 Python fields needed. -->
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="contract_id"/>
                <field name="due_date"/>
                <field name="days_to_due"/>
                <field name="lead_time_days"/>
                <field name="state"/>
                <field name="rag_color"/>
                <field name="responsible_id"/>
                <templates>
                    <t t-name="card">
                        <t t-set="govoo_color" t-value="record.rag_color.raw_value == 'red' ? 'danger' : (record.rag_color.raw_value == 'amber' ? 'warning' : (record.rag_color.raw_value == 'green' ? 'success' : 'secondary'))"/>
                        <t t-set="govoo_progress" t-value="record.lead_time_days.raw_value ? Math.min(100, Math.max(0, Math.round((record.lead_time_days.raw_value - record.days_to_due.raw_value) / record.lead_time_days.raw_value * 100))) : false"/>
                        <div t-attf-class="border-start border-4 border-{{govoo_color}} ps-2">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <span class="text-muted d-block"><field name="contract_id"/></span>
                                </div>
                                <field name="rag_color" widget="badge"
                                       decoration-success="rag_color == 'green'"
                                       decoration-warning="rag_color == 'amber'"
                                       decoration-danger="rag_color == 'red'"
                                       decoration-muted="rag_color == 'grey'"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted"><field name="state"/></div>
                                <div t-if="record.due_date.raw_value">Due <field name="due_date"/></div>
                                <div t-if="govoo_progress !== false" class="mt-1">
                                    <div class="progress" style="height: 6px;">
                                        <div t-attf-class="progress-bar bg-{{govoo_color}}" t-attf-style="width: {{govoo_progress}}%"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_right">
                                    <field name="responsible_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="govoo_contract_obligation_view_search" model="ir.ui.view">
        <field name="name">govoo.contract.obligation.search</field>
        <field name="model">govoo.contract.obligation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contract_id"/>
                <field name="responsible_id"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="govoo_contract_obligation_dashboard_action" model="ir.actions.act_window">
        <field name="name">Obligations</field>
        <field name="res_model">govoo.contract.obligation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

</odoo>
