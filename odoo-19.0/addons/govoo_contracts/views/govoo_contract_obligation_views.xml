<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_contract_obligation_view_list" model="ir.ui.view">
        <field name="name">govoo.contract.obligation.list</field>
        <field name="model">govoo.contract.obligation</field>
        <field name="arch" type="xml">
            <list>
                <field name="contract_id"/>
                <field name="name"/>
                <field name="due_date"/>
                <field name="days_to_due"/>
                <field name="responsible_id"/>
                <field name="amount"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('done', 'waived')"
                       decoration-warning="state == 'open'"
                       decoration-danger="state == 'overdue'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_contract_obligation_view_form" model="ir.ui.view">
        <field name="name">govoo.contract.obligation.form</field>
        <field name="model">govoo.contract.obligation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" string="Mark Done"
                            type="object" class="oe_highlight"
                            invisible="state in ('done', 'waived')"/>
                    <button name="action_waive" string="Waive"
                            type="object"
                            invisible="state in ('done', 'waived')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="name"/>
                            <field name="due_date"/>
                            <field name="days_to_due"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="amount"/>
                            <field name="lead_time_days"/>
                            <field name="rag_color" widget="badge"
                                   decoration-success="rag_color == 'green'"
                                   decoration-warning="rag_color == 'amber'"
                                   decoration-danger="rag_color == 'red'"
                                   decoration-muted="rag_color == 'grey'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="govoo_contract_obligation_view_kanban" model="ir.ui.view">
        <field name="name">govoo.contract.obligation.kanban</field>
        <field name="model">govoo.contract.obligation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="contract_id"/>
                <field name="due_date"/>
                <field name="days_to_due"/>
                <field name="state"/>
                <field name="rag_color"/>
                <templates>
                    <t t-name="card">
                        <field name="contract_id"/>
                        <field name="name"/>
                        <field name="due_date"/>
                        <field name="rag_color" widget="badge"
                               decoration-success="rag_color == 'green'"
                               decoration-warning="rag_color == 'amber'"
                               decoration-danger="rag_color == 'red'"
                               decoration-muted="rag_color == 'grey'"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="govoo_contract_obligation_view_search" model="ir.ui.view">
        <field name="name">govoo.contract.obligation.search</field>
        <field name="model">govoo.contract.obligation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contract_id"/>
                <field name="responsible_id"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="govoo_contract_obligation_dashboard_action" model="ir.actions.act_window">
        <field name="name">Obligations</field>
        <field name="res_model">govoo.contract.obligation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

</odoo>
