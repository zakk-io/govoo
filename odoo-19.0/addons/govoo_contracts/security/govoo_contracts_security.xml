<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Multi-company record rules (same pattern as every other govoo_*
         module: company_id scoping via the shared Governance User
         group, not a bespoke isolation mechanism). Portal-scoped record
         rules for Contract Viewer (Portal) are added by the Portal Access
         feature cluster (issue #177), not here. -->
    <record id="govoo_contract_comp_rule" model="ir.rule">
        <field name="name">Contract: multi-company</field>
        <field name="model_id" ref="model_govoo_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
    </record>

    <record id="govoo_contract_type_comp_rule" model="ir.rule">
        <field name="name">Contract Type: multi-company</field>
        <field name="model_id" ref="model_govoo_contract_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
    </record>

    <record id="govoo_contract_delegation_comp_rule" model="ir.rule">
        <field name="name">Contract Delegation of Authority: multi-company</field>
        <field name="model_id" ref="model_govoo_contract_delegation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
    </record>

    <!-- Contract Viewer Portal: own contracts only, as counterparty or
         named approver (BR-CM-007, security/record-rules.md section 6b),
         "deny, don't merely hide" discipline, same as every other portal
         record rule in this codebase. -->
    <record id="govoo_contract_portal_rule" model="ir.rule">
        <field name="name">Contract: Contract Viewer Portal own contracts</field>
        <field name="model_id" ref="model_govoo_contract"/>
        <field name="domain_force">['|', ('counterparty_id', '=', user.partner_id.id), ('portal_approver_ids', 'in', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_contract_portal'))]"/>
    </record>

    <record id="govoo_contract_template_comp_rule" model="ir.rule">
        <field name="name">Contract Template: multi-company</field>
        <field name="model_id" ref="model_govoo_contract_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
    </record>

    <record id="govoo_contract_clause_comp_rule" model="ir.rule">
        <field name="name">Contract Clause: multi-company</field>
        <field name="model_id" ref="model_govoo_contract_clause"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
    </record>

    <record id="govoo_contract_obligation_comp_rule" model="ir.rule">
        <field name="name">Contract Obligation: multi-company</field>
        <field name="model_id" ref="model_govoo_contract_obligation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
    </record>

    <record id="govoo_contract_milestone_comp_rule" model="ir.rule">
        <field name="name">Contract Milestone: multi-company</field>
        <field name="model_id" ref="model_govoo_contract_milestone"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_user'))]"/>
    </record>

    <!-- Contract Viewer Portal: obligations/milestones inherit the same
         "own contracts" scope via contract_id, per
         security/record-rules.md section 6b. -->
    <record id="govoo_contract_obligation_portal_rule" model="ir.rule">
        <field name="name">Contract Obligation: Contract Viewer Portal own contracts</field>
        <field name="model_id" ref="model_govoo_contract_obligation"/>
        <field name="domain_force">['|', ('contract_id.counterparty_id', '=', user.partner_id.id), ('contract_id.portal_approver_ids', 'in', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_contract_portal'))]"/>
    </record>

    <record id="govoo_contract_milestone_portal_rule" model="ir.rule">
        <field name="name">Contract Milestone: Contract Viewer Portal own contracts</field>
        <field name="model_id" ref="model_govoo_contract_milestone"/>
        <field name="domain_force">['|', ('contract_id.counterparty_id', '=', user.partner_id.id), ('contract_id.portal_approver_ids', 'in', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('govoo_base.group_govoo_contract_portal'))]"/>
    </record>

</odoo>
