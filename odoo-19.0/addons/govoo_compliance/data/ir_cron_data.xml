<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Daily cron: generate upcoming instances from active obligations -->
    <record id="cron_generate_compliance_instances" model="ir.cron">
        <field name="name">Compliance: Generate Instances</field>
        <field name="model_id" ref="model_govoo_compliance_instance"/>
        <field name="state">code</field>
        <field name="code">model.env['govoo.compliance.cron']._cron_generate_instances()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <!-- Daily cron: send staged reminders for upcoming/in_progress instances -->
    <record id="cron_send_compliance_reminders" model="ir.cron">
        <field name="name">Compliance: Send Reminders</field>
        <field name="model_id" ref="model_govoo_compliance_instance"/>
        <field name="state">code</field>
        <field name="code">model.env['govoo.compliance.cron']._cron_send_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <!-- Daily cron: escalate overdue instances to late -->
    <record id="cron_escalate_compliance_late" model="ir.cron">
        <field name="name">Compliance: Escalate Late</field>
        <field name="model_id" ref="model_govoo_compliance_instance"/>
        <field name="state">code</field>
        <field name="code">model.env['govoo.compliance.cron']._cron_escalate_late()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

</odoo>
