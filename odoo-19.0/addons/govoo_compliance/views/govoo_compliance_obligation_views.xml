<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="govoo_compliance_obligation_view_list" model="ir.ui.view">
        <field name="name">govoo.compliance.obligation.list</field>
        <field name="model">govoo.compliance.obligation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="authority"/>
                <field name="frequency"/>
                <field name="basis"/>
                <field name="lead_time_days"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="govoo_compliance_obligation_view_form" model="ir.ui.view">
        <field name="name">govoo.compliance.obligation.form</field>
        <field name="model">govoo.compliance.obligation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="authority"/>
                            <field name="frequency"/>
                            <field name="basis"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="lead_time_days"/>
                            <field name="applies_to_entity_type"/>
                            <group string="Fixed Date"
                                   invisible="basis != 'fixed_date'">
                                <field name="fixed_day"/>
                                <field name="fixed_month"/>
                            </group>
                            <group string="FYE Relative"
                                   invisible="basis != 'fye_relative'">
                                <field name="fye_offset_months"/>
                            </group>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instances" name="instances">
                            <field name="instance_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="govoo_compliance_obligation_view_search" model="ir.ui.view">
        <field name="name">govoo.compliance.obligation.search</field>
        <field name="model">govoo.compliance.obligation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="authority"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_frequency" string="Frequency"
                            context="{'group_by': 'frequency'}"/>
                    <filter name="group_basis" string="Basis"
                            context="{'group_by': 'basis'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="govoo_compliance_obligation_action" model="ir.actions.act_window">
        <field name="name">Compliance Obligations</field>
        <field name="res_model">govoo.compliance.obligation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
